OPU_WEBAPP_STATE_DIR=/var/lib/oracle-patching/controller
OPU_WEBAPP_HOSTS_FILE=/etc/oracle-patching/hosts.json
OPU_WEBAPP_ALLOW_FIXTURES=0
OPU_WEBAPP_RBAC=1
OPU_WEBAPP_PRINCIPALS_FILE=/etc/oracle-patching/principals.json
OPU_WEBAPP_PORT=8765
OPU_AGENT_ENROLLMENT_REQUIRED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONNOUSERSITE=1
PYTHONUNBUFFERED=1
HOME=/var/lib/oracle-patching-home
TMPDIR=/run/oracle-patching
# Add OPU_OIDC_CONFIG only after configuring the chosen company provider.
# An optional assistant-config.json is installed when explicitly supplied.
