[Unit]
Description=Local-only Ollama for Oracle Patching
After=network.target

[Service]
Type=simple
User=opu-ollama
Group=opu-ollama
Environment=HOME=/var/lib/oracle-patching-ollama
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_MODELS=/var/lib/oracle-patching-ollama/models
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/oracle-patching-ollama
PrivateTmp=yes
# CPU baseline. GPU device access requires a reviewed hardware-specific override.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
