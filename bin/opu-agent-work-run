#!/usr/bin/env bash
# Lab pull-agent runner: claim one queued job for a node, execute the mapped
# sealed plan executor (the mutation boundary), and complete the queue job
# with the executor exit code and a stdout digest. Lab bridge only; this is
# not an enrolled mTLS agent. OPU_AGENT_EXECUTOR_<ADAPTER> (uppercased, dots
# and dashes as underscores) is a test-only override of the executor path.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=lib/opu/python.sh
. "$ROOT/lib/opu/python.sh"
NODE=""; AGENT=""; LEASE=120; TOKEN=""
QUEUE_DIR=${OPU_AGENT_QUEUE_DIR:-"$ROOT/webapp/var/agent-queue"}

usage() {
  printf '%s\n' \
    'Usage: opu-agent-work-run --node NAME --agent-id ID [--lease-seconds N]' \
    '           [--queue-dir DIR] [--agent-token TOKEN]' \
    '' \
    'Requires OPU_PLAN_STATE_DIR to point at the sealed plan state directory.'
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --node) NODE=${2:-}; shift 2 ;;
    --agent-id) AGENT=${2:-}; shift 2 ;;
    --lease-seconds) LEASE=${2:-}; shift 2 ;;
    --queue-dir) QUEUE_DIR=${2:-}; shift 2 ;;
    --agent-token) TOKEN=${2:-}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
  esac
done

[ -n "$NODE" ] && [ -n "$AGENT" ] || { usage >&2; exit 64; }
if [ -z "${OPU_PLAN_STATE_DIR:-}" ]; then
  echo 'opu-agent-work-run: OPU_PLAN_STATE_DIR must be set to the sealed plan state directory (fail closed)' >&2
  exit 78
fi
export OPU_AGENT_QUEUE_DIR="$QUEUE_DIR"

OPU_WR_ROOT="$ROOT" OPU_WR_NODE="$NODE" OPU_WR_AGENT="$AGENT" \
OPU_WR_LEASE="$LEASE" OPU_WR_TOKEN="$TOKEN" \
opu_python - <<'PY'
import json, os, sys
sys.path.insert(0, os.path.join(os.environ["OPU_WR_ROOT"], "webapp"))
from agent_worker import run_once
job, exit_code = run_once(os.environ["OPU_WR_NODE"], os.environ["OPU_WR_AGENT"],
                          int(os.environ["OPU_WR_LEASE"]), os.environ.get("OPU_WR_TOKEN") or None)
print(json.dumps(job, indent=2, sort_keys=True))
raise SystemExit(exit_code)
PY
