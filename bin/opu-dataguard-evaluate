#!/usr/bin/env bash
# Fail-closed Data Guard evaluation. Consumes sealed observe evidence and a
# lag/broker policy; emits ready_for_standby_first or blocked. Exit 2 when
# blocked. Does not mutate the estate.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/common.sh"

OBSERVE=""; POLICY=""; OUT=""
declare -a GATES=()

usage() {
  printf '%s\n' 'Usage: opu-dataguard-evaluate --observe ABSOLUTE_JSON --policy ABSOLUTE_JSON [--output ABSOLUTE_JSON]'
}

die() { opu_error "$*"; exit 65; }
gate() { GATES+=("$1|$2|$3"); }
has_blocker() { local item; for item in "${GATES[@]}"; do [ "$(cut -d'|' -f2 <<<"$item")" = blocker ] && return 0; done; return 1; }
gate_json() {
  local item first=1
  printf '['
  for item in "${GATES[@]}"; do
    [ "$first" -eq 1 ] || printf ','
    jq -cn --arg name "${item%%|*}" --arg status "$(cut -d'|' -f2 <<<"$item")" --arg detail "$(cut -d'|' -f3- <<<"$item")" \
      '{name:$name,status:$status,detail:$detail}'
    first=0
  done
  printf ']'
}

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --observe) OBSERVE=${2:-}; shift 2 ;;
      --policy) POLICY=${2:-}; shift 2 ;;
      --output) OUT=${2:-}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  done
  for pair in "$OBSERVE|observe" "$POLICY|policy"; do
    opu_validate_absolute_path "${pair%%|*}" "${pair#*|}" || exit $?
    [ -f "${pair%%|*}" ] && [ ! -L "${pair%%|*}" ] || { opu_error "${pair#*|} missing"; exit 66; }
  done
  [ -z "$OUT" ] || opu_validate_absolute_path "$OUT" output || exit $?
  command -v jq >/dev/null || die 'jq is required'
}

check_contracts() {
  jq -e '
    .schema_version == "1.0" and
    .collector.name == "oracle.dataguard.observe" and
    (.primary.database_role | type == "string" and length > 0) and
    (.members | type == "array")
  ' "$OBSERVE" >/dev/null || die 'observe evidence violates the Data Guard v1 contract'
  jq -e '
    .schema_version == "1.0" and
    (.dataguard.max_transport_lag_seconds | type == "number" and . >= 0) and
    (.dataguard.max_apply_lag_seconds | type == "number" and . >= 0) and
    (.dataguard.require_broker | type == "boolean")
  ' "$POLICY" >/dev/null || die 'Data Guard policy violates the v1 contract'
}

evaluate() {
  local role broker require_broker max_transport max_apply member_count transport apply status name
  role=$(jq -r '.primary.database_role' "$OBSERVE")
  case "$role" in
    PRIMARY) gate role pass 'Observed role is PRIMARY; standby-first order is applicable.' ;;
    *STANDBY*) gate role pass "Observed role is $role; evaluation may authorize standby-side work." ;;
    *) gate role blocker "Unsupported database role: $role" ;;
  esac

  require_broker=$(jq -r '.dataguard.require_broker' "$POLICY")
  broker=$(jq -r '.broker.status // "unavailable"' "$OBSERVE")
  if [ "$require_broker" = true ]; then
    case "$broker" in
      configured|enabled|ENABLED) gate broker pass "Broker status is $broker." ;;
      *) gate broker blocker "Broker is required but status is $broker." ;;
    esac
  else
    gate broker pass "Broker requirement disabled by policy (status=$broker)."
  fi

  member_count=$(jq -r '.members | length' "$OBSERVE")
  if [ "$role" = PRIMARY ] && [ "$member_count" -lt 1 ]; then
    gate members blocker 'PRIMARY observation has no standby members.'
  else
    gate members pass "Observed $member_count Data Guard member(s)."
  fi

  max_transport=$(jq -r '.dataguard.max_transport_lag_seconds' "$POLICY")
  max_apply=$(jq -r '.dataguard.max_apply_lag_seconds' "$POLICY")
  while IFS=$'\t' read -r name status transport apply; do
    [ -n "$name" ] || continue
    case "$status" in
      APPLYING_LOG|applying_log|ENABLED|enabled|VALID|valid)
        gate member_status pass "$name status is $status."
        ;;
      *)
        gate member_status blocker "$name status is $status; expected apply-capable."
        ;;
    esac
    if [[ "$transport" =~ ^-?[0-9]+$ ]] && [ "$transport" -ge 0 ] && [ "$transport" -le "$max_transport" ]; then
      gate lag pass "$name transport lag ${transport}s within ${max_transport}s."
    else
      gate lag blocker "$name transport lag ${transport}s exceeds policy ${max_transport}s."
    fi
    if [[ "$apply" =~ ^-?[0-9]+$ ]] && [ "$apply" -ge 0 ] && [ "$apply" -le "$max_apply" ]; then
      gate lag pass "$name apply lag ${apply}s within ${max_apply}s."
    else
      gate lag blocker "$name apply lag ${apply}s exceeds policy ${max_apply}s."
    fi
  done < <(jq -r '.members[] | [.db_unique_name // "", .status // "unknown", (.transport_lag_seconds // -1 | tostring), (.apply_lag_seconds // -1 | tostring)] | @tsv' "$OBSERVE")
}

emit() {
  local file=$1 status evaluated_at evidence
  if has_blocker; then status=blocked; else status=ready_for_standby_first; fi
  evaluated_at=$(opu_now_utc)
  evidence=$(jq -cn --arg observe "$(opu_hash_file "$OBSERVE")" --arg policy "$(opu_hash_file "$POLICY")" \
    '{observe_sha256:$observe,policy_sha256:$policy}')
  jq -cn --arg status "$status" --arg evaluated_at "$evaluated_at" \
    --argjson gates "$(gate_json)" --argjson evidence "$evidence" \
    '{schema_version:"1.0",status:$status,evaluated_at:$evaluated_at,gates:$gates,evidence:$evidence}' >"$file"
  local canonical hash
  canonical=$(jq -cS . "$file"); hash=$(opu_hash_string "$canonical")
  jq --arg hash "$hash" '.record_sha256=$hash' "$file" >"${file}.hashed"
  mv "${file}.hashed" "$file"
}

main() {
  parse "$@"
  check_contracts
  evaluate
  local tmp
  if [ -n "$OUT" ]; then
    mkdir -p "$(dirname "$OUT")"
    [ ! -L "$OUT" ] || die 'output cannot be a symbolic link'
    tmp=$OUT
  else
    tmp=$(mktemp "${TMPDIR:-/tmp}/opu-dg-eval.XXXXXX")
    trap 'rm -f "${tmp:-}"' EXIT
  fi
  emit "$tmp"
  cat "$tmp"
  if has_blocker; then exit 2; fi
  exit 0
}

main "$@"
