#!/usr/bin/env bash
# Fail-closed Data Guard evaluation. Consumes sealed observe evidence and a
# lag/broker policy; emits ready_for_standby_first or blocked. Exit 2 when
# blocked. Does not mutate the estate.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/common.sh"
. "$ROOT/lib/opu/dataguard.sh"

OBSERVE=""; POLICY=""; OUT=""
declare -a GATES=()

usage() {
  printf '%s\n' 'Usage: opu-dataguard-evaluate --observe ABSOLUTE_JSON --policy ABSOLUTE_JSON [--output ABSOLUTE_JSON]'
}

die() { opu_error "$*"; exit 65; }
gate() { GATES+=("$1|$2|$3"); }
has_blocker() { local item; for item in "${GATES[@]}"; do [ "$(cut -d'|' -f2 <<<"$item")" = blocker ] && return 0; done; return 1; }
gate_json() {
  local item first=1
  printf '['
  for item in "${GATES[@]}"; do
    [ "$first" -eq 1 ] || printf ','
    jq -cn --arg name "${item%%|*}" --arg status "$(cut -d'|' -f2 <<<"$item")" --arg detail "$(cut -d'|' -f3- <<<"$item")" \
      '{name:$name,status:$status,detail:$detail}'
    first=0
  done
  printf ']'
}

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --observe) OBSERVE=${2:-}; shift 2 ;;
      --policy) POLICY=${2:-}; shift 2 ;;
      --output) OUT=${2:-}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  done
  for pair in "$OBSERVE|observe" "$POLICY|policy"; do
    opu_validate_absolute_path "${pair%%|*}" "${pair#*|}" || exit $?
    [ -f "${pair%%|*}" ] && [ ! -L "${pair%%|*}" ] || { opu_error "${pair#*|} missing"; exit 66; }
  done
  opu_dataguard_validate_output "$OUT" || exit $?
  command -v jq >/dev/null || die 'jq is required'
}

check_contracts() {
  local canonical expected
  jq -e '
    def valid_name: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._$#-]{0,127}$");
    .schema_version == "1.0" and .collector.name == "oracle.dataguard.observe" and
    (.primary.database_role | type == "string" and length > 0) and
    (.collected_at | type == "string" and length > 0) and
    (.members | type == "array") and
    all(.members[]; (.db_unique_name | valid_name) and (.status | type == "string") and
      (.transport_lag_seconds == null or (.transport_lag_seconds | type == "number" and . == floor)) and
      (.apply_lag_seconds == null or (.apply_lag_seconds | type == "number" and . == floor))) and
    ((.members | map(.db_unique_name) | length) == (.members | map(.db_unique_name) | unique | length)) and
    (if .collector.version == "2" then
      (.target.db_unique_name | valid_name) and .target.db_unique_name == .primary.db_unique_name and
      .sampling.source == "live_sql" and all(.members[]; (.lag_samples | type == "object") and
        .lag_samples.transport.seconds == .transport_lag_seconds and .lag_samples.apply.seconds == .apply_lag_seconds)
     else true end)
  ' "$OBSERVE" >/dev/null || die 'observe evidence violates the Data Guard v1 contract'
  expected=$(jq -r '.record_sha256 // ""' "$OBSERVE")
  canonical=$(jq -cS 'del(.record_sha256)' "$OBSERVE")
  [ "$expected" = "$(opu_hash_string "$canonical")" ] || die 'observe record checksum does not match its content'
  jq -e '
    def nonnegative_integer: type == "number" and . >= 0 and . == floor;
    .schema_version == "1.0" and
    (.dataguard.max_transport_lag_seconds | nonnegative_integer) and
    (.dataguard.max_apply_lag_seconds | nonnegative_integer) and
    (.dataguard.require_broker | type == "boolean") and
    ((.dataguard.maximum_observation_age_seconds // 300) | nonnegative_integer and . > 0) and
    ((.dataguard.maximum_sample_age_seconds // 60) | nonnegative_integer and . > 0)
  ' "$POLICY" >/dev/null || die 'Data Guard policy violates the v1 contract'
}

check_freshness() {
  local age maximum sample_max samples name kind computed datum status
  maximum=$(jq -r '.dataguard.maximum_observation_age_seconds // 300' "$POLICY")
  sample_max=$(jq -r '.dataguard.maximum_sample_age_seconds // 60' "$POLICY")
  age=$(jq -er '(now - (.collected_at | fromdateiso8601)) | floor' "$OBSERVE") \
    || die 'invalid Data Guard observation collection timestamp'
  if [ "$age" -ge 0 ] && [ "$age" -le "$maximum" ]; then
    gate observation_freshness pass "Observation is ${age}s old (maximum ${maximum}s)."
  else
    gate observation_freshness blocker "Observation age ${age}s is outside 0..${maximum}s."
  fi
  if jq -e '.collector.version == "2" or .sampling.source == "live_sql"' "$OBSERVE" >/dev/null; then
    samples=$(jq -r '.members[] | .db_unique_name as $name |
      ["transport","apply"][] as $kind | (.lag_samples[$kind] // {}) as $sample |
      [$name,$kind,($sample.status // "unavailable"),($sample.time_computed_age_seconds // -1),($sample.datum_age_seconds // -1)] | @tsv' "$OBSERVE") \
      || die 'could not inspect Data Guard sample clocks'
    while IFS=$'\t' read -r name kind status computed datum; do
      [ -n "$name" ] || continue
      if [ "$status" = collected ] && [[ "$computed" =~ ^[0-9]+$ ]] && [[ "$datum" =~ ^[0-9]+$ ]] &&
        jq -en --argjson computed "$computed" --argjson datum "$datum" --argjson age "$age" --argjson maximum "$sample_max" \
          '$age >= 0 and ($computed + $age) <= $maximum and ($datum + $age) <= $maximum' >/dev/null; then
        gate sample_freshness pass "$name $kind computation/data ages at collection ${computed}/${datum}s plus observation age ${age}s are within ${sample_max}s."
      else
        gate sample_freshness blocker "$name $kind metric has missing, future or stale TIME_COMPUTED/DATUM_TIME (status=$status; computed=$computed; datum=$datum; max=${sample_max}s)."
      fi
    done <<<"$samples"
  else
    # Preserve the original fixture contract; live version 2 may never omit its
    # sample clocks. Legacy data remains explicitly distinguishable in gates.
    gate sample_freshness warning 'Legacy v1 evidence has no native sample clocks; only collection freshness can be checked.'
  fi
}

evaluate() {
  local role broker require_broker max_transport max_apply member_count transport apply status name member_rows
  check_freshness
  role=$(jq -r '.primary.database_role' "$OBSERVE")
  case "$role" in
    PRIMARY) gate role pass 'Observed role is PRIMARY; standby-first order is applicable.' ;;
    *STANDBY*) gate role pass "Observed role is $role; evaluation may authorize standby-side work." ;;
    *) gate role blocker "Unsupported database role: $role" ;;
  esac

  require_broker=$(jq -r '.dataguard.require_broker' "$POLICY")
  broker=$(jq -r '.broker.status // "unavailable"' "$OBSERVE")
  if [ "$require_broker" = true ]; then
    case "$broker" in
      configured|enabled|ENABLED) gate broker pass "Broker status is $broker." ;;
      *) gate broker blocker "Broker is required but status is $broker." ;;
    esac
  else
    gate broker pass "Broker requirement disabled by policy (status=$broker)."
  fi

  member_count=$(jq -r '.members | length' "$OBSERVE")
  # Standby-first readiness always needs at least one member lag sample.
  # Empty members used to pass for *STANDBY* roles and fail open.
  if [ "$member_count" -lt 1 ]; then
    gate members blocker 'Data Guard observation has no members; cannot evaluate lag or standby-first readiness.'
  else
    gate members pass "Observed $member_count Data Guard member(s)."
  fi

  max_transport=$(jq -r '.dataguard.max_transport_lag_seconds' "$POLICY")
  max_apply=$(jq -r '.dataguard.max_apply_lag_seconds' "$POLICY")
  member_rows=$(jq -r '.members[] | [.db_unique_name, .status, (.transport_lag_seconds // -1 | tostring), (.apply_lag_seconds // -1 | tostring)] | @tsv' "$OBSERVE") \
    || die 'could not inspect Data Guard members'
  while IFS=$'\t' read -r name status transport apply; do
    [ -n "$name" ] || continue
    case "$status" in
      APPLYING_LOG|applying_log|WAIT_FOR_LOG|wait_for_log|ENABLED|enabled|VALID|valid)
        gate member_status pass "$name status is $status."
        ;;
      *)
        gate member_status blocker "$name status is $status; expected apply-capable."
        ;;
    esac
    if [[ "$transport" =~ ^-?[0-9]+$ ]] && [ "$transport" -ge 0 ] && [ "$transport" -le "$max_transport" ]; then
      gate lag pass "$name transport lag ${transport}s within ${max_transport}s."
    else
      gate lag blocker "$name transport lag ${transport}s is unknown or exceeds policy ${max_transport}s."
    fi
    if [[ "$apply" =~ ^-?[0-9]+$ ]] && [ "$apply" -ge 0 ] && [ "$apply" -le "$max_apply" ]; then
      gate lag pass "$name apply lag ${apply}s within ${max_apply}s."
    else
      gate lag blocker "$name apply lag ${apply}s is unknown or exceeds policy ${max_apply}s."
    fi
  done <<<"$member_rows"
}

emit() {
  local file=$1 status evaluated_at evidence
  if has_blocker; then status=blocked; else status=ready_for_standby_first; fi
  evaluated_at=$(opu_now_utc)
  evidence=$(jq -cn --arg observe "$(opu_hash_file "$OBSERVE")" --arg policy "$(opu_hash_file "$POLICY")" \
    '{observe_sha256:$observe,policy_sha256:$policy}')
  jq -cn --arg status "$status" --arg evaluated_at "$evaluated_at" \
    --argjson gates "$(gate_json)" --argjson evidence "$evidence" --slurpfile observe "$OBSERVE" \
    '{schema_version:"1.0",status:$status,evaluated_at:$evaluated_at,gates:$gates,evidence:$evidence,
      target:{db_unique_name:($observe[0].target.db_unique_name // $observe[0].primary.db_unique_name // null),
        oracle_home:$observe[0].target.oracle_home,oracle_sid:$observe[0].target.oracle_sid,
        database_role:$observe[0].primary.database_role},observed_at:$observe[0].collected_at}' >"$file"
  local canonical hash
  canonical=$(jq -cS . "$file"); hash=$(opu_hash_string "$canonical")
  jq --arg hash "$hash" '.record_sha256=$hash' "$file" >"${file}.hashed"
  mv "${file}.hashed" "$file"
}

main() {
  parse "$@"
  check_contracts
  evaluate
  local tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/opu-dg-result.XXXXXX")
  trap 'rm -f "${tmp:-}" "${tmp:-}.hashed"' EXIT
  emit "$tmp"
  opu_dataguard_publish "$tmp" "$OUT"
  if has_blocker; then exit 2; fi
  exit 0
}

main "$@"
