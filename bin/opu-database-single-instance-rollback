#!/usr/bin/env bash
# Separate entry point for the independently approved standalone rollback
# adapter. All selectors still come from the sealed rollback plan.
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export OPU_SINGLE_INSTANCE_OPERATION=rollback
exec "$ROOT/bin/opu-database-single-instance-patch" "$@"
