#!/usr/bin/env bash
# Controlled RAC Database RU patch workflow. Grid and database patches are
# intentionally separate executables and separate approval scopes.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C

P=${0##*/}; DB=""; DB_HOME=""; PATCH_DIR=""; PATCH_ID=""; MODE=""; NODE_FILE=""; LOG_ROOT=/var/tmp; REMOTE_USER=root; APPROVED=0; BACKUP_EVIDENCE=""; MIN_FREE_MB=4096
GRID_HOME=""; DB_OWNER=""; LOCAL_HOST=$(hostname -s 2>/dev/null || hostname); STATE=""; DONE=""; LOG=""; FAIL=""; CURRENT_NODE=""
TEST_MODE=${OPU_DATABASE_ROLLING_TEST_MODE:-0}
declare -a NODES=()
die() { [[ -n "$FAIL" ]] && printf 'time=%s\nnode=%s\nmessage=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${CURRENT_NODE:-unknown}" "$*" >"$FAIL"; printf '%s: ERROR: %s\n' "$P" "$*" >&2; exit 1; }
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"; }
usage() { cat <<EOF
Usage:
  $P --database DB --patch-dir PATH --mode analyze [--nodes FILE] [options]
  $P --database DB --patch-dir PATH --mode apply [--nodes FILE] --approve --backup-evidence-sha256 SHA256 [options]
  $P --database DB --patch-id ID --mode rollback [--nodes FILE] --approve --backup-evidence-sha256 SHA256 [options]

Options: --db-home PATH --grid-home PATH --remote-user USER --log-root PATH
         --patch-id ID --min-free-mb MB

When --nodes is omitted, active RAC nodes are discovered from olsnodes. Use
--nodes only to supply an explicit, ordered test or maintenance scope.
EOF
}
vpath() { [[ "$1" == /* && "$1" != *$'\n'* && "$1" != */../* && "$1" != */.. && "$1" != */./* && "$1" != */. ]]; }
vid() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]]; }
vnode() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]]; }
vpatch() { [[ "$1" =~ ^[0-9]{1,20}$ ]]; }
vdigest() { [[ "$1" =~ ^[a-f0-9]{64}$ ]]; }
short() { printf '%s' "${1%%.*}"; }
local_node() { [[ "$(short "$1")" == "$(short "$LOCAL_HOST")" ]]; }
root() { local n=$1; shift; if local_node "$n"; then "$@"; elif [[ "$REMOTE_USER" == root ]]; then ssh -o BatchMode=yes -o ConnectTimeout=30 "root@$n" -- "$@"; else sudo -u "$REMOTE_USER" ssh -o BatchMode=yes -o ConnectTimeout=30 "$REMOTE_USER@$n" -- sudo -n "$@"; fi; }
dbuser() { local n=$1; shift; if [[ "$TEST_MODE" == 1 ]] && local_node "$n"; then "$@"; elif local_node "$n"; then runuser -u "$DB_OWNER" -- "$@"; elif [[ "$REMOTE_USER" == root ]]; then ssh -o BatchMode=yes -o ConnectTimeout=30 "root@$n" -- runuser -u "$DB_OWNER" -- "$@"; else sudo -u "$REMOTE_USER" ssh -o BatchMode=yes -o ConnectTimeout=30 "$REMOTE_USER@$n" -- sudo -n runuser -u "$DB_OWNER" -- "$@"; fi; }
acquire_lock() {
  local dir=$1 flock_command=flock
  if [[ "$TEST_MODE" == 1 && -n "${OPU_DATABASE_ROLLING_TEST_FLOCK:-}" ]]; then
    flock_command=$OPU_DATABASE_ROLLING_TEST_FLOCK
    [[ -x "$flock_command" ]] || die 'test flock command is not executable'
  fi
  if [[ "$flock_command" != flock ]] || command -v flock >/dev/null 2>&1; then
    exec 9>"$dir/.lock"
    "$flock_command" -n 9 || die "another run owns $dir"
  else
    die 'flock is required for database rolling patch execution'
  fi
}
step() { grep -Fqx "$1" "$DONE" 2>/dev/null; }
done_step() { printf '%s\n' "$1" >>"$DONE"; }
add_node() { local n=$1; vnode "$n" || die "invalid node $n"; [[ " ${NODES[*]-} " == *" $n "* ]] || NODES+=("$n"); }
read_nodes() {
  local n inventory
  if [[ -n "$NODE_FILE" ]]; then
    [[ -f "$NODE_FILE" && ! -L "$NODE_FILE" ]] || die "node file missing or symbolic link"
    while IFS= read -r n || [[ -n "$n" ]]; do n=${n%%#*}; n=${n//[[:space:]]/}; [[ -z "$n" ]] && continue; add_node "$n"; done <"$NODE_FILE"
  else
    inventory=$("$GRID_HOME/bin/olsnodes" -s -t 2>&1) || die "cannot discover active RAC nodes with olsnodes"
    printf '=== discovered RAC nodes ===\n%s\n' "$inventory" >>"$LOG"
    while IFS= read -r n; do add_node "$n"; done < <(awk '$2 == "Active" {print $1}' <<<"$inventory")
  fi
  ((${#NODES[@]})) || die "no active RAC nodes discovered"
}
grid_env() { GRID_HOME=${GRID_HOME:-}; [[ -n "$GRID_HOME" ]] || GRID_HOME=$(dirname "$(dirname "$(command -v srvctl 2>/dev/null || true)")"); [[ -x "$GRID_HOME/bin/srvctl" ]] || die "--grid-home is required when srvctl is not on PATH"; }
discover_db() { local cfg; cfg=$("$GRID_HOME/bin/srvctl" config database -db "$DB" 2>&1) || die "database is not registered with srvctl: $DB"; [[ -z "$LOG" ]] || printf '%s\n' "$cfg" >>"$LOG"; local found; found=$(awk -F: 'tolower($1) ~ /^oracle home$/ {sub(/^[[:space:]]*/,"",$2); print $2; exit}' <<<"$cfg"); if [[ -z "$DB_HOME" ]]; then DB_HOME=$found; fi; [[ -n "$DB_HOME" && "$DB_HOME" = "$found" ]] || die "database home does not match srvctl configuration"; [[ -d "$DB_HOME" ]] || die "database home missing: $DB_HOME"; DB_OWNER=$(stat -c '%U' "$DB_HOME" 2>/dev/null || stat -f '%Su' "$DB_HOME" 2>/dev/null || true); [[ -n "$DB_OWNER" && "$DB_OWNER" != root ]] || die "invalid database owner"; }
detect_patch() { [[ -n "$PATCH_ID" ]] && return; PATCH_ID=$(basename "$PATCH_DIR" | grep -Eo '[0-9]{6,20}' | head -n1 || true); vpatch "$PATCH_ID" || die "supply --patch-id"; }
space() { local n=$1 path=$2 out free; out=$(root "$n" df -Pm "$path" 2>&1) || die "$n: cannot check $path"; printf '%s\n' "$out" >>"$LOG"; free=$(awk 'NR>1 {v=$4} END{print v+0}' <<<"$out"); [ "$free" -ge "$MIN_FREE_MB" ] || die "$n: ${free}MB free at $path; need $MIN_FREE_MB"; }
installed() { local n=$1 out; out=$(dbuser "$n" "$DB_HOME/OPatch/opatch" lspatches -oh "$DB_HOME" 2>&1 || true); printf '%s\n' "$out" >>"$LOG"; grep -Eq "^[[:space:]]*${PATCH_ID}([;[:space:]]|$)" <<<"$out"; }
metadata() { local n=$1 out id; [[ "$MODE" == rollback ]] && return; out=$(root "$n" grep -RhoE 'patchID[[:space:]]*=[[:space:]]*"?[0-9]+' "$PATCH_DIR" 2>/dev/null || true); id=$(grep -Eo '[0-9]+' <<<"$out" | head -n1 || true); vpatch "$id" || die "$n: patch XML has no patchID"; [[ "$id" = "$PATCH_ID" ]] || die "$n: patch XML ID $id does not match $PATCH_ID"; }
database_health() {
  local n=$1 sid=$2 output role mode log_mode instance instance_status
  output=$(printf '%s\n' \
    'set pages 0 feedback off heading off verify off echo off trimspool on lines 1000' \
    "select database_role || '|' || open_mode || '|' || log_mode from v\$database;" \
    "select instance_name || '|' || status from v\$instance;" \
    'exit' | dbuser "$n" env "ORACLE_HOME=$DB_HOME" "ORACLE_SID=$sid" "PATH=$DB_HOME/bin:/usr/bin:/bin" "$DB_HOME/bin/sqlplus" -L -s '/ as sysdba' 2>&1) || die "$n: SYSDBA health query failed"
  printf '=== %s database health ===\n%s\n' "$n" "$output" >>"$LOG"
  grep -qiE '(^|[[:space:]])ORA-[0-9]+|SP2-[0-9]+' <<<"$output" && die "$n: SYSDBA health query returned an Oracle error"
  role=$(awk -F'|' '/^[[:space:]]*[A-Z ]+\|[A-Z ]+\|[A-Z ]+[[:space:]]*$/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1); print $1; exit}' <<<"$output")
  mode=$(awk -F'|' '/^[[:space:]]*[A-Z ]+\|[A-Z ]+\|[A-Z ]+[[:space:]]*$/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' <<<"$output")
  log_mode=$(awk -F'|' '/^[[:space:]]*[A-Z ]+\|[A-Z ]+\|[A-Z ]+[[:space:]]*$/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); print $3; exit}' <<<"$output")
  instance=$(awk -F'|' '/^[[:space:]]*[A-Za-z0-9_$#]+\|[A-Z ]+[[:space:]]*$/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1); print $1; exit}' <<<"$output")
  instance_status=$(awk -F'|' '/^[[:space:]]*[A-Za-z0-9_$#]+\|[A-Z ]+[[:space:]]*$/ {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' <<<"$output")
  [[ "$role" = PRIMARY && "$mode" = 'READ WRITE' && "$instance_status" = OPEN ]] || die "$n: database is not a primary, read-write, open instance"
  [[ "$(short "$instance")" = "$(short "$sid")" ]] || die "$n: SYSDBA query reached unexpected instance $instance"
  log "$n: database health verified (role=$role open_mode=$mode log_mode=$log_mode instance=$instance)"
}
preflight() {
  local n=$1 instance_status sid
  root "$n" test -d "$DB_HOME" || die "$n: DB home missing"
  root "$n" test -x "$DB_HOME/OPatch/opatch" || die "$n: opatch missing"
  root "$n" test -x "$DB_HOME/bin/sqlplus" || die "$n: sqlplus missing"
  [[ "$MODE" == rollback ]] || root "$n" test -d "$PATCH_DIR" || die "$n: patch staging missing"
  space "$n" "$DB_HOME"; [[ "$MODE" == rollback ]] || space "$n" "$PATCH_DIR"
  instance_status=$(root "$n" "$GRID_HOME/bin/srvctl" status instance -db "$DB" -node "$n" 2>&1) || die "$n: DB instance status is unavailable"
  printf '=== %s instance status ===\n%s\n' "$n" "$instance_status" >>"$LOG"
  if grep -qiE 'not running|not configured|does not exist|cannot' <<<"$instance_status"; then die "$n: database instance is not running; patch workflow is blocked"; fi
  grep -qiE 'is running|running on node' <<<"$instance_status" || die "$n: database instance status is ambiguous; patch workflow is blocked"
  sid=$(sed -nE 's/^[Ii]nstance[[:space:]]+([^[:space:]]+)[[:space:]]+is[[:space:]]+running.*/\1/p' <<<"$instance_status" | head -n1)
  vid "$sid" || die "$n: cannot determine running instance name from srvctl output"
  log "$n: database instance status verified as running (instance=$sid)"
  database_health "$n" "$sid"
}
analyze() { local n=$1; installed "$n" && { log "$n: patch already installed"; return; }; metadata "$n"; log "$n: checking DB-home patch platform applicability"; dbuser "$n" "$DB_HOME/OPatch/opatch" prereq CheckPatchApplicableOnCurrentPlatform -ph "$PATCH_DIR" -oh "$DB_HOME" >>"$LOG" 2>&1 || die "$n: platform applicability check failed"; log "$n: checking DB-home patch conflicts"; dbuser "$n" "$DB_HOME/OPatch/opatch" prereq CheckConflictAgainstOHWithDetail -ph "$PATCH_DIR" -oh "$DB_HOME" >>"$LOG" 2>&1 || die "$n: conflict check failed"; }
wait_instance() { local n=$1 i=0; while ((i<30)); do root "$n" "$GRID_HOME/bin/srvctl" status instance -db "$DB" -node "$n" 2>&1 | grep -qi 'running' && return 0; sleep 2; i=$((i+1)); done; die "$n: instance did not start"; }
patch_node() { local n=$1; local base="${MODE}|${n}"; if [[ "$MODE" = apply ]] && installed "$n"; then log "$n: already installed"; return; fi; if [[ "$MODE" = rollback ]] && ! installed "$n"; then log "$n: not installed"; return; fi; metadata "$n"; if ! step "$base|stopped"; then root "$n" "$GRID_HOME/bin/srvctl" stop instance -db "$DB" -node "$n" -stopoption immediate >>"$LOG" 2>&1 || die "$n: instance stop failed"; done_step "$base|stopped"; fi; if ! step "$base|opatch"; then if [[ "$MODE" = apply ]]; then dbuser "$n" "$DB_HOME/OPatch/opatch" apply "$PATCH_DIR" -oh "$DB_HOME" -local -silent >>"$LOG" 2>&1 || die "$n: OPatch apply failed"; else dbuser "$n" "$DB_HOME/OPatch/opatch" rollback -id "$PATCH_ID" -oh "$DB_HOME" -local -silent >>"$LOG" 2>&1 || die "$n: OPatch rollback failed"; fi; done_step "$base|opatch"; fi; if ! step "$base|started"; then root "$n" "$GRID_HOME/bin/srvctl" start instance -db "$DB" -node "$n" >>"$LOG" 2>&1 || die "$n: instance start failed"; wait_instance "$n"; done_step "$base|started"; fi; }
datapatch_validate() { local n=${NODES[0]}; step "${MODE}|datapatch" || { dbuser "$n" env "ORACLE_HOME=$DB_HOME" "PATH=$DB_HOME/bin:$DB_HOME/OPatch:/usr/bin:/bin" "$DB_HOME/OPatch/datapatch" -verbose >>"$LOG" 2>&1 || die "datapatch failed"; done_step "${MODE}|datapatch"; }; root "$n" "$GRID_HOME/bin/srvctl" status database -db "$DB" >>"$LOG" 2>&1 || die "database postcheck failed"; }
parse() { while (($#)); do case "$1" in --database) DB=${2:-}; shift 2;; --db-home) DB_HOME=${2:-}; shift 2;; --grid-home) GRID_HOME=${2:-}; shift 2;; --patch-dir) PATCH_DIR=${2:-}; shift 2;; --patch-id) PATCH_ID=${2:-}; shift 2;; --mode) MODE=${2:-}; shift 2;; --nodes) NODE_FILE=${2:-}; shift 2;; --log-root) LOG_ROOT=${2:-}; shift 2;; --remote-user) REMOTE_USER=${2:-}; shift 2;; --backup-evidence-sha256) BACKUP_EVIDENCE=${2:-}; shift 2;; --min-free-mb) MIN_FREE_MB=${2:-}; shift 2;; --approve) APPROVED=1; shift;; -h|--help) usage; exit 0;; *) die "unknown option $1";; esac; done; }
main() { parse "$@"; [[ $EUID -eq 0 ]] || [[ "$TEST_MODE" == 1 ]] || die "must run as root"; vid "$DB" || die "--database required"; [[ "$MODE" =~ ^(analyze|apply|rollback)$ ]] || die "invalid mode"; [[ -z "$NODE_FILE" ]] || vpath "$NODE_FILE" || die "--nodes must be a normalized absolute path"; vpath "$LOG_ROOT" || die "invalid log root"; vnode "$REMOTE_USER" || die "invalid remote user"; [[ "$MIN_FREE_MB" =~ ^[0-9]{1,7}$ ]] && [ "$MIN_FREE_MB" -ge 256 ] || die "minimum free MB must be at least 256"; if [[ "$MODE" = rollback ]]; then vpatch "$PATCH_ID" || die "rollback requires patch ID"; else vpath "$PATCH_DIR" || die "patch directory required"; fi; if [[ "$MODE" != analyze ]]; then [ "$APPROVED" -eq 1 ] || die "mutation requires --approve"; vdigest "$BACKUP_EVIDENCE" || die "mutation requires --backup-evidence-sha256"; fi; grid_env; discover_db; detect_patch; STATE="${LOG_ROOT%/}/opu-database-rolling-${DB}-${MODE}-${PATCH_ID}"; mkdir -p "$STATE"; DONE="$STATE/completed.steps"; LOG="$STATE/$P.log"; FAIL="$STATE/last.failure"; touch "$DONE" "$LOG"; read_nodes; printf 'database=%s\nmode=%s\npatch_id=%s\ndb_home=%s\nnodes=%s\n' "$DB" "$MODE" "$PATCH_ID" "$DB_HOME" "${NODES[*]}" >"$STATE/run.manifest"; acquire_lock "$STATE"; log "database=$DB mode=$MODE patch_id=$PATCH_ID db_home=$DB_HOME nodes=${NODES[*]}"; local n; for n in "${NODES[@]}"; do CURRENT_NODE=$n; preflight "$n"; done; for n in "${NODES[@]}"; do CURRENT_NODE=$n; if [[ "$MODE" = analyze ]]; then analyze "$n"; else patch_node "$n"; fi; done; [[ "$MODE" = analyze ]] || datapatch_validate; log "completed successfully; evidence=$STATE"; }
main "$@"
