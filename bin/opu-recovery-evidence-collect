#!/usr/bin/env bash
# Collects content-addressed recovery evidence for one standalone database.
# This command is read-only. It validates, but never creates or restores, a
# backup. The resulting record is intended to be sealed into an execution plan.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/common.sh"

SNAPSHOT=""
DATABASE=""
BACKUP_ROOT=""
OUT=""
RMAN_COMMAND_RUNTIME=""

usage() {
  printf '%s\n' \
    'Usage: opu-recovery-evidence-collect --snapshot ABSOLUTE_JSON --database DB_UNIQUE_NAME --backup-root ABSOLUTE_DIR --output ABSOLUTE_JSON'
}

die() { opu_error "$*"; exit 65; }

cleanup_runtime_command() {
  local runtime_file=${RMAN_COMMAND_RUNTIME:-}
  [ -n "$runtime_file" ] || return 0
  if [ -e "$runtime_file" ] && [ ! -L "$runtime_file" ]; then
    rm -f -- "$runtime_file"
  fi
  RMAN_COMMAND_RUNTIME=""
}

require_root() {
  [ "${EUID:-$(id -u)}" -eq 0 ] ||
    [ "${OPU_RECOVERY_TEST_ALLOW_NONROOT:-0}" = 1 ] ||
    die 'this operation must run as root'
}

as_owner() {
  local owner=$1
  shift
  if [ "$(id -un)" = "$owner" ]; then
    "$@"
  else
    runuser -u "$owner" -- "$@"
  fi
}

owner_for_path() {
  stat -c '%U' "$1" 2>/dev/null || stat -f '%Su' "$1" 2>/dev/null || true
}

epoch() {
  date -u -d "$1" +%s 2>/dev/null ||
    date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || return 1
}

iso_from_epoch() {
  date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null ||
    date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || return 1
}

safe_oracle_path() {
  opu_validate_absolute_path "$1" "$2" || return
  case "$1" in
    *[!A-Za-z0-9._/+:-]*)
      opu_error "$2 contains characters that cannot be bound safely"
      return 64
      ;;
  esac
}

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --snapshot) SNAPSHOT=${2:-}; shift 2 ;;
      --database) DATABASE=${2:-}; shift 2 ;;
      --backup-root) BACKUP_ROOT=${2:-}; shift 2 ;;
      --output) OUT=${2:-}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  done
  require_root
  # This is a JSON input path, never interpolated into SQL/RMAN. Control-plane
  # snapshots may have spaces and are mirrored verbatim for plan binding.
  opu_validate_absolute_path "$SNAPSHOT" snapshot || exit $?
  safe_oracle_path "$BACKUP_ROOT" backup-root || exit $?
  safe_oracle_path "$OUT" output || exit $?
  opu_validate_identifier "$DATABASE" database >/dev/null || die 'invalid database name'
  [ -f "$SNAPSHOT" ] && [ ! -L "$SNAPSHOT" ] || die 'snapshot is missing or symbolic link'
  [ -d "$BACKUP_ROOT" ] && [ ! -L "$BACKUP_ROOT" ] || die 'backup root is missing or symbolic link'
  [ ! -L "$OUT" ] || die 'output cannot be a symbolic link'
  command -v jq >/dev/null || die 'jq is required'
  command -v sha256sum >/dev/null || die 'sha256sum is required'
}

resolve_target() {
  local count
  jq -e '.schema_version == "1.0" and .collector.name == "oracle.topology.discover"' "$SNAPSHOT" >/dev/null || die 'snapshot contract is invalid'
  count=$(jq -r --arg database "$DATABASE" '[.databases[] | select(.db_unique_name == $database)] | length' "$SNAPSHOT")
  [ "$count" -eq 1 ] || die "snapshot must contain exactly one database named $DATABASE"
  ORACLE_HOME=$(jq -r --arg database "$DATABASE" '.databases[] | select(.db_unique_name == $database) | .oracle_home // empty' "$SNAPSHOT")
  safe_oracle_path "$ORACLE_HOME" oracle-home || exit $?
  [ -d "$ORACLE_HOME" ] && [ ! -L "$ORACLE_HOME" ] || die 'discovered Oracle home is missing or symbolic link'
  ORACLE_OWNER=$(jq -r --arg oracle_home "$ORACLE_HOME" '.oracle_homes[] | select(.path == $oracle_home) | .owner // empty' "$SNAPSHOT" | sort -u)
  [ "$(printf '%s\n' "$ORACLE_OWNER" | sed '/^$/d' | wc -l | tr -d ' ')" -eq 1 ] || die 'Oracle-home owner is missing or ambiguous'
  [ "$(owner_for_path "$ORACLE_HOME")" = "$ORACLE_OWNER" ] || die 'live Oracle-home owner differs from the snapshot'
  [ -x "$ORACLE_HOME/bin/sqlplus" ] && [ -x "$ORACLE_HOME/bin/rman" ] || die 'SQL*Plus or RMAN is unavailable in the discovered Oracle home'
  ORACLE_SID=$(jq -r --arg database "$DATABASE" '.databases[] | select(.db_unique_name == $database) | .runtime.instance // empty' "$SNAPSHOT")
  opu_validate_identifier "$ORACLE_SID" oracle-sid >/dev/null || die 'snapshot does not contain a valid running instance SID'
}

validate_checksum_manifest() {
  local line digest path count=0 archive_count=0 expected actual canonical
  CHECKSUM_MANIFEST="$BACKUP_ROOT/SHA256SUMS"
  [ -f "$CHECKSUM_MANIFEST" ] && [ ! -L "$CHECKSUM_MANIFEST" ] || die 'backup SHA256SUMS is missing or symbolic link'
  CHECKSUM_LOG="$EVIDENCE_DIR/sha256-verify.log"
  PREPARATION_MANIFEST=""
  INVENTORY_ARCHIVE=""
  ORAINST_BACKUP=""
  if [ -e "$BACKUP_ROOT/PREPARATION.json" ]; then
    PREPARATION_MANIFEST="$BACKUP_ROOT/PREPARATION.json"
    [ -f "$PREPARATION_MANIFEST" ] && [ ! -L "$PREPARATION_MANIFEST" ] || die 'preparation manifest is not a regular file'
    jq -e --arg root "$BACKUP_ROOT" --arg database "$DATABASE" --arg oracle_home "$ORACLE_HOME" '
      .schema_version == "1.0" and
      .collector.name == "oracle.database.recovery.preparation" and
      .collector.version == "1" and
      .target.database_unique_name == $database and
      .target.oracle_home == $oracle_home and
      (.record_sha256 | test("^[a-f0-9]{64}$")) and
      (.source_request.path | type == "string" and startswith("/")) and
      (.source_request.sha256 | test("^[a-f0-9]{64}$")) and
      (.source_request.record_sha256 | test("^[a-f0-9]{64}$")) and
      (.rman.piece_root == ($root + "/rman")) and
      (.artifacts.oracle_home_archive.path | startswith($root + "/")) and
      (.artifacts.central_inventory_archive.path | startswith($root + "/")) and
      (.artifacts.oraInst_loc.path | startswith($root + "/"))
    ' "$PREPARATION_MANIFEST" >/dev/null || die 'preparation manifest contract or target binding is invalid'
    expected=$(jq -r '.record_sha256' "$PREPARATION_MANIFEST")
    canonical=$(jq -cS 'del(.record_sha256)' "$PREPARATION_MANIFEST")
    actual=$(opu_hash_string "$canonical")
    [ "$actual" = "$expected" ] || die 'preparation manifest integrity verification failed'
    SOURCE_REQUEST=$(jq -r '.source_request.path' "$PREPARATION_MANIFEST")
    safe_oracle_path "$SOURCE_REQUEST" source-request || exit $?
    [ -f "$SOURCE_REQUEST" ] && [ ! -L "$SOURCE_REQUEST" ] || die 'immutable preparation source request is unavailable'
    [ "$(opu_hash_file "$SOURCE_REQUEST")" = "$(jq -r '.source_request.sha256' "$PREPARATION_MANIFEST")" ] || die 'immutable preparation source-request file digest changed'
    expected=$(jq -r '.source_request.record_sha256' "$PREPARATION_MANIFEST")
    actual=$(opu_hash_string "$(jq -cS 'del(.record_sha256)' "$SOURCE_REQUEST")")
    [ "$actual" = "$expected" ] || die 'immutable preparation source-request record digest changed'
    jq -e --arg request_id "$(jq -r '.request_id' "$PREPARATION_MANIFEST")" --arg database "$DATABASE" --arg oracle_home "$ORACLE_HOME" '
      .collector.name == "oracle.database.recovery.prepare.request" and
      .request_id == $request_id and .target.database_unique_name == $database and
      .target.oracle_home == $oracle_home
    ' "$SOURCE_REQUEST" >/dev/null || die 'immutable preparation source request targets another operation'
    HOME_ARCHIVE=$(jq -r '.artifacts.oracle_home_archive.path' "$PREPARATION_MANIFEST")
    INVENTORY_ARCHIVE=$(jq -r '.artifacts.central_inventory_archive.path' "$PREPARATION_MANIFEST")
    ORAINST_BACKUP=$(jq -r '.artifacts.oraInst_loc.path' "$PREPARATION_MANIFEST")
  fi
  : >"$EVIDENCE_DIR/files.tsv"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    digest=${line%%[[:space:]]*}
    path=${line#*  }
    [[ "$digest" =~ ^[a-f0-9]{64}$ ]] || die 'SHA256SUMS contains an invalid digest'
    safe_oracle_path "$path" backup-file || exit $?
    case "$path" in "$BACKUP_ROOT"/*) ;; *) die 'SHA256SUMS references a file outside the selected backup root' ;; esac
    [ -f "$path" ] && [ ! -L "$path" ] || die "backup file is missing or symbolic link: $path"
    printf '%s\t%s\n' "$digest" "$path" >>"$EVIDENCE_DIR/files.tsv"
    count=$((count + 1))
    if [ -z "$PREPARATION_MANIFEST" ]; then
      case "$path" in *.tar.gz|*.tgz) HOME_ARCHIVE=$path; archive_count=$((archive_count + 1)) ;; esac
    fi
  done <"$CHECKSUM_MANIFEST"
  [ "$count" -ge 2 ] || die 'SHA256SUMS must bind at least the database backup and Oracle-home archive'
  if [ -n "$PREPARATION_MANIFEST" ]; then
    for path in "$PREPARATION_MANIFEST" "$HOME_ARCHIVE" "$INVENTORY_ARCHIVE" "$ORAINST_BACKUP"; do
      safe_oracle_path "$path" prepared-artifact || exit $?
      awk -F '\t' -v expected_path="$path" '$2 == expected_path {found=1} END {exit !found}' "$EVIDENCE_DIR/files.tsv" ||
        die "prepared artifact is not bound by SHA256SUMS: $path"
    done
  else
    [ "$archive_count" -eq 1 ] || die 'SHA256SUMS must contain exactly one Oracle-home tar archive'
  fi
  (cd / && sha256sum -c "$CHECKSUM_MANIFEST") >"$CHECKSUM_LOG" 2>&1 || die "backup checksum verification failed; see $CHECKSUM_LOG"
  ARCHIVE_LOG="$EVIDENCE_DIR/oracle-home-archive-verify.log"
  tar -tzf "$HOME_ARCHIVE" >"$ARCHIVE_LOG" 2>&1 || die "Oracle-home archive validation failed; see $ARCHIVE_LOG"
  [ -s "$ARCHIVE_LOG" ] || die 'Oracle-home archive is empty'
  ! grep -Eq '(^/|(^|/)\.\.(/|$))' "$ARCHIVE_LOG" || die 'Oracle-home archive contains an unsafe member path'
  if [ -n "$PREPARATION_MANIFEST" ]; then
    INVENTORY_ARCHIVE_LOG="$EVIDENCE_DIR/central-inventory-archive-verify.log"
    tar -tzf "$INVENTORY_ARCHIVE" >"$INVENTORY_ARCHIVE_LOG" 2>&1 || die 'Central Inventory archive validation failed'
    [ -s "$INVENTORY_ARCHIVE_LOG" ] || die 'Central Inventory archive is empty'
    ! grep -Eq '(^/|(^|/)\.\.(/|$))' "$INVENTORY_ARCHIVE_LOG" || die 'Central Inventory archive contains an unsafe member path'
    ORAINST_SOURCE=$(jq -r '.artifacts.oraInst_loc.source_path' "$PREPARATION_MANIFEST")
    safe_oracle_path "$ORAINST_SOURCE" oraInst-source || exit $?
    [ -f "$ORAINST_SOURCE" ] && [ ! -L "$ORAINST_SOURCE" ] || die 'live oraInst.loc source is unavailable'
    cmp -s "$ORAINST_SOURCE" "$ORAINST_BACKUP" || die 'retained oraInst.loc differs from the live source'
  fi
}

collect_backup_set_keys() {
  local sql_file=$1 keys_file=$2 escaped_root
  escaped_root=${BACKUP_ROOT//\'/\'\'}
  cat >"$sql_file" <<EOF
whenever sqlerror exit failure
set pages 0 heading off feedback off verify off echo off trimspool on lines 32767
select distinct bs.recid
  from v\$backup_set bs
  join v\$backup_piece bp
    on bp.set_stamp = bs.set_stamp and bp.set_count = bs.set_count
 where bp.status = 'A'
   and bp.handle like '${escaped_root}/%'
 order by bs.recid;
exit;
EOF
  as_owner "$ORACLE_OWNER" env \
    "ORACLE_HOME=$ORACLE_HOME" "ORACLE_SID=$ORACLE_SID" \
    "PATH=$ORACLE_HOME/bin:/usr/bin:/bin" \
    "$ORACLE_HOME/bin/sqlplus" -L -s '/ as sysdba' <"$sql_file" >"$keys_file" 2>"$EVIDENCE_DIR/backup-set-query.stderr" ||
    die 'could not resolve RMAN backup-set keys for the selected backup root'
  sed -E 's/^[[:space:]]+|[[:space:]]+$//g' "$keys_file" | sed '/^$/d' >"$keys_file.clean"
  mv "$keys_file.clean" "$keys_file"
  grep -Eq '^[0-9]+$' "$keys_file" || die 'selected backup root has no RMAN backup sets'
  if grep -Ev '^[0-9]+$' "$keys_file" >/dev/null; then die 'RMAN backup-set query returned unexpected data'; fi
}

validate_recovery_coverage() {
  local sql_file="$EVIDENCE_DIR/backup-coverage-query.sql" output_file="$EVIDENCE_DIR/backup-coverage.txt"
  local escaped_root datafiles_backed base_datafiles datafiles_current controlfiles spfiles outside_pieces unavailable_pieces extra observed_at age_seconds
  escaped_root=${BACKUP_ROOT//\'/\'\'}
  cat >"$sql_file" <<EOF
whenever sqlerror exit failure
set pages 0 heading off feedback off verify off echo off trimspool on lines 32767
-- OPU_RECOVERY_COVERAGE
with selected_sets as (
  select distinct bs.set_stamp, bs.set_count
    from v\$backup_set bs
    join v\$backup_piece bp
      on bp.set_stamp = bs.set_stamp and bp.set_count = bs.set_count
   where bp.handle like '${escaped_root}/%'
)
select
  (select count(distinct bd.file#) from v\$backup_datafile bd join selected_sets s on s.set_stamp=bd.set_stamp and s.set_count=bd.set_count where bd.file# > 0)
  || '|' || (select count(distinct bd.file#) from v\$backup_datafile bd join selected_sets s on s.set_stamp=bd.set_stamp and s.set_count=bd.set_count where bd.file# > 0 and (bd.incremental_level is null or bd.incremental_level = 0))
  || '|' || (select count(*) from v\$datafile)
  || '|' || (select count(*) from v\$backup_datafile bd join selected_sets s on s.set_stamp=bd.set_stamp and s.set_count=bd.set_count where bd.file# = 0)
  || '|' || (select count(*) from v\$backup_spfile sp join selected_sets s on s.set_stamp=sp.set_stamp and s.set_count=sp.set_count)
  || '|' || (select count(*) from v\$backup_piece bp join selected_sets s on s.set_stamp=bp.set_stamp and s.set_count=bp.set_count where bp.handle not like '${escaped_root}/%')
  || '|' || (select count(*) from v\$backup_piece bp join selected_sets s on s.set_stamp=bp.set_stamp and s.set_count=bp.set_count where bp.status <> 'A')
  || '|' || to_char(sys_extract_utc(systimestamp), 'YYYY-MM-DD"T"HH24:MI:SS"Z"')
  || '|' || (select floor((sysdate - min(bs.completion_time)) * 86400)
               from v\$backup_set bs
               join selected_sets s on s.set_stamp=bs.set_stamp and s.set_count=bs.set_count
               join v\$backup_datafile bd on bd.set_stamp=bs.set_stamp and bd.set_count=bs.set_count
              where bd.file# > 0 and (bd.incremental_level is null or bd.incremental_level = 0))
from dual;
exit;
EOF
  as_owner "$ORACLE_OWNER" env \
    "ORACLE_HOME=$ORACLE_HOME" "ORACLE_SID=$ORACLE_SID" \
    "PATH=$ORACLE_HOME/bin:/usr/bin:/bin" \
    "$ORACLE_HOME/bin/sqlplus" -L -s '/ as sysdba' <"$sql_file" >"$output_file" 2>"$EVIDENCE_DIR/backup-coverage-query.stderr" ||
    die 'could not verify recovery-set coverage'
  IFS='|' read -r datafiles_backed base_datafiles datafiles_current controlfiles spfiles outside_pieces unavailable_pieces observed_at age_seconds extra < <(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' "$output_file" | sed '/^$/d')
  for value in "$datafiles_backed" "$base_datafiles" "$datafiles_current" "$controlfiles" "$spfiles" "$outside_pieces" "$unavailable_pieces" "$age_seconds"; do
    [[ "$value" =~ ^[0-9]+$ ]] || die 'recovery coverage query returned unexpected data'
  done
  [[ "$observed_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || die 'recovery timing query returned an invalid observation timestamp'
  [ -z "${extra:-}" ] || die 'recovery coverage query returned extra fields'
  [ "$age_seconds" -ge 0 ] || die 'selected recovery backup completion is in the future'
  [ "$datafiles_current" -gt 0 ] && [ "$datafiles_backed" -eq "$datafiles_current" ] || die 'selected recovery set does not cover every current datafile'
  [ "$base_datafiles" -eq "$datafiles_current" ] || die 'selected recovery set does not contain a full or level-0 base for every datafile'
  [ "$controlfiles" -gt 0 ] || die 'selected recovery set has no control-file backup'
  [ "$spfiles" -gt 0 ] || die 'selected recovery set has no SPFILE backup'
  [ "$outside_pieces" -eq 0 ] || die 'a selected RMAN backup set has pieces outside the approved backup root'
  [ "$unavailable_pieces" -eq 0 ] || die 'a selected RMAN backup set contains unavailable pieces'
  DATAFILES_BACKED=$datafiles_backed
  BASE_DATAFILES=$base_datafiles
  DATAFILES_CURRENT=$datafiles_current
  CONTROLFILE_RECORDS=$controlfiles
  SPFILE_RECORDS=$spfiles
  SELECTED_OBSERVED_AT=$observed_at
  SELECTED_AGE_SECONDS=$age_seconds
  observed_epoch=$(epoch "$observed_at") || die 'recovery timing observation timestamp cannot be parsed'
  SELECTED_OLDEST_COMPLETED_AT=$(iso_from_epoch "$((observed_epoch - age_seconds))") || die 'selected recovery completion timestamp cannot be represented'
}

validate_rman_sets() {
  local key count=0 command_file="$EVIDENCE_DIR/rman-validate.cmd" oracle_group
  BACKUP_KEYS_FILE="$EVIDENCE_DIR/rman-backup-set-keys.txt"
  collect_backup_set_keys "$EVIDENCE_DIR/backup-set-query.sql" "$BACKUP_KEYS_FILE"
  validate_recovery_coverage
  {
    printf '%s\n' 'list backup summary;'
    while IFS= read -r key; do
      [[ "$key" =~ ^[0-9]+$ ]] || die 'invalid RMAN backup-set key'
      printf 'validate backupset %s;\n' "$key"
      count=$((count + 1))
    done <"$BACKUP_KEYS_FILE"
    printf '%s\n' 'restore database validate;'
    printf '%s\n' 'exit;'
  } >"$command_file"
  [ "$count" -gt 0 ] || die 'no RMAN backup sets were selected'
  RMAN_COMMAND_RUNTIME=$(mktemp /tmp/opu-rman-validate.XXXXXX) || die 'could not create a protected RMAN command file'
  cp "$command_file" "$RMAN_COMMAND_RUNTIME"
  oracle_group=$(id -gn "$ORACLE_OWNER") || die 'could not resolve the Oracle owner primary group'
  if [ "$(id -u)" -eq 0 ]; then
    chown "$ORACLE_OWNER:$oracle_group" "$RMAN_COMMAND_RUNTIME"
  else
    [ "$(id -un)" = "$ORACLE_OWNER" ] || die 'non-root test execution cannot bind the RMAN command file to another owner'
  fi
  chmod 0400 "$RMAN_COMMAND_RUNTIME"

  RMAN_SYNTAX_LOG="$EVIDENCE_DIR/rman-validate-syntax.log"
  RMAN_SYNTAX_RC_FILE="$EVIDENCE_DIR/rman-validate-syntax.exit-code"
  set +e
  as_owner "$ORACLE_OWNER" env \
    "ORACLE_HOME=$ORACLE_HOME" \
    "PATH=$ORACLE_HOME/bin:/usr/bin:/bin" \
    "$ORACLE_HOME/bin/rman" CHECKSYNTAX CMDFILE "$RMAN_COMMAND_RUNTIME" \
    >"$RMAN_SYNTAX_LOG" 2>&1
  RMAN_SYNTAX_RC=$?
  set -e
  printf '%s\n' "$RMAN_SYNTAX_RC" >"$RMAN_SYNTAX_RC_FILE"
  [ "$RMAN_SYNTAX_RC" -eq 0 ] || die "generated RMAN validation command failed syntax checking; see $RMAN_SYNTAX_LOG"
  if grep -Eq 'RMAN-00569|RMAN-00558|RMAN-0100[6-9]' "$RMAN_SYNTAX_LOG"; then
    die "generated RMAN validation command reported a syntax error; see $RMAN_SYNTAX_LOG"
  fi

  RMAN_LOG="$EVIDENCE_DIR/rman-validate.log"
  RMAN_RC_FILE="$EVIDENCE_DIR/rman-validate.exit-code"
  set +e
  as_owner "$ORACLE_OWNER" env \
    "ORACLE_HOME=$ORACLE_HOME" "ORACLE_SID=$ORACLE_SID" \
    "PATH=$ORACLE_HOME/bin:/usr/bin:/bin" \
    "$ORACLE_HOME/bin/rman" TARGET / CMDFILE "$RMAN_COMMAND_RUNTIME" >"$RMAN_LOG" 2>&1
  RMAN_RC=$?
  set -e
  printf '%s\n' "$RMAN_RC" >"$RMAN_RC_FILE"
  cleanup_runtime_command
  [ "$RMAN_RC" -eq 0 ] || die "RMAN backup validation failed with exit code $RMAN_RC; see $RMAN_LOG"
  if grep -Eq 'RMAN-00569|RMAN-03002|ORA-[0-9]{5}' "$RMAN_LOG"; then
    die "RMAN backup validation reported an Oracle error; see $RMAN_LOG"
  fi
  [ "$(grep -c 'validation complete' "$RMAN_LOG" || true)" -ge "$count" ] ||
    die "RMAN did not report validation complete for every selected set; see $RMAN_LOG"
  grep -q 'Finished restore at' "$RMAN_LOG" || die "RMAN restore selection validation did not complete; see $RMAN_LOG"
  RESTORE_HANDLES="$EVIDENCE_DIR/rman-restore-piece-handles.txt"
  sed -nE 's/.*reading from backup piece[[:space:]]+([^[:space:]]+).*/\1/p' "$RMAN_LOG" | sort -u >"$RESTORE_HANDLES"
  [ -s "$RESTORE_HANDLES" ] || die 'RMAN restore validation exposed no selected backup-piece handles'
  while IFS= read -r restore_handle; do
    case "$restore_handle" in "$BACKUP_ROOT"/*) ;; *) die "RMAN restore validation selected a piece outside the approved backup root: $restore_handle" ;; esac
    awk -F '\t' -v handle="$restore_handle" '$2 == handle { found=1 } END { exit !found }' "$EVIDENCE_DIR/files.tsv" ||
      die "RMAN validated a backup piece that is not bound by SHA256SUMS: $restore_handle"
  done <"$RESTORE_HANDLES"
  FINAL_CHECKSUM_LOG="$EVIDENCE_DIR/sha256-verify-after-rman.log"
  (cd / && sha256sum -c "$CHECKSUM_MANIFEST") >"$FINAL_CHECKSUM_LOG" 2>&1 ||
    die 'backup content changed during RMAN validation'
  SELECTED_RESTORE_HANDLES=$(jq -Rn '[inputs | select(length > 0)]' <"$RESTORE_HANDLES")
}

emit_record() {
  local tmp canonical record_sha files_json keys_json preparation_json storage_json available_kb total_kb device_id
  files_json=$(jq -Rn '[inputs | split("\t") | {sha256:.[0],path:.[1]}]' <"$EVIDENCE_DIR/files.tsv")
  keys_json=$(jq -Rn '[inputs | tonumber]' <"$BACKUP_KEYS_FILE")
  read -r total_kb available_kb < <(df -Pk "$BACKUP_ROOT" | awk 'NR==2 {print $2, $4}')
  device_id=$(stat -c '%d' "$BACKUP_ROOT" 2>/dev/null || stat -f '%d' "$BACKUP_ROOT" 2>/dev/null) || die 'backup filesystem identity is unavailable'
  [[ "$total_kb" =~ ^[0-9]+$ ]] && [[ "$available_kb" =~ ^[0-9]+$ ]] && [[ "$device_id" =~ ^[0-9]+$ ]] || die 'backup filesystem capacity is unavailable'
  [ "$total_kb" -ge "$available_kb" ] || die 'backup filesystem capacity is invalid'
  storage_json=$(jq -cn --arg path "$BACKUP_ROOT" --arg device "$device_id" --arg at "$(opu_now_utc)" \
    --argjson total "$((total_kb * 1024))" --argjson available "$((available_kb * 1024))" \
    '{type:"filesystem",path:$path,device_id:$device,total_bytes:$total,available_bytes:$available,observed_at:$at}')
  preparation_json=null
  if [ -n "$PREPARATION_MANIFEST" ]; then
    preparation_json=$(jq -cn \
      --arg path "$PREPARATION_MANIFEST" --arg sha "$(opu_hash_file "$PREPARATION_MANIFEST")" \
      --arg record "$(jq -r '.record_sha256' "$PREPARATION_MANIFEST")" \
      --arg inventory "$INVENTORY_ARCHIVE" --arg inventory_sha "$(opu_hash_file "$INVENTORY_ARCHIVE")" \
      --arg orainst "$ORAINST_BACKUP" --arg orainst_sha "$(opu_hash_file "$ORAINST_BACKUP")" \
      '{manifest:{path:$path,sha256:$sha,record_sha256:$record},central_inventory_archive:{path:$inventory,sha256:$inventory_sha},oraInst_loc:{path:$orainst,sha256:$orainst_sha}}')
  fi
  tmp="$OUT.tmp.$$"
  jq -cn \
    --arg collected_at "$(opu_now_utc)" \
    --arg database "$DATABASE" --arg oracle_home "$ORACLE_HOME" --arg owner "$ORACLE_OWNER" --arg sid "$ORACLE_SID" \
    --arg backup_root "$BACKUP_ROOT" --arg snapshot_path "$SNAPSHOT" --arg snapshot_sha "$(opu_hash_file "$SNAPSHOT")" \
    --arg checksum_path "$CHECKSUM_MANIFEST" --arg checksum_sha "$(opu_hash_file "$CHECKSUM_MANIFEST")" \
    --arg checksum_log "$CHECKSUM_LOG" --arg checksum_log_sha "$(opu_hash_file "$CHECKSUM_LOG")" \
    --arg archive "$HOME_ARCHIVE" --arg archive_log "$ARCHIVE_LOG" --arg archive_log_sha "$(opu_hash_file "$ARCHIVE_LOG")" \
    --arg rman_syntax_log "$RMAN_SYNTAX_LOG" --arg rman_syntax_log_sha "$(opu_hash_file "$RMAN_SYNTAX_LOG")" \
    --arg rman_syntax_rc_path "$RMAN_SYNTAX_RC_FILE" --arg rman_syntax_rc_sha "$(opu_hash_file "$RMAN_SYNTAX_RC_FILE")" --argjson rman_syntax_rc "$RMAN_SYNTAX_RC" \
    --arg rman_log "$RMAN_LOG" --arg rman_log_sha "$(opu_hash_file "$RMAN_LOG")" \
    --arg rman_rc_path "$RMAN_RC_FILE" --arg rman_rc_sha "$(opu_hash_file "$RMAN_RC_FILE")" --argjson rman_rc "$RMAN_RC" \
    --argjson files "$files_json" --argjson keys "$keys_json" \
    --argjson datafiles_backed "$DATAFILES_BACKED" --argjson base_datafiles "$BASE_DATAFILES" --argjson datafiles_current "$DATAFILES_CURRENT" \
    --argjson controlfile_records "$CONTROLFILE_RECORDS" --argjson spfile_records "$SPFILE_RECORDS" \
    --arg observed_at "$SELECTED_OBSERVED_AT" --arg completed_at "$SELECTED_OLDEST_COMPLETED_AT" --argjson age_seconds "$SELECTED_AGE_SECONDS" \
    --argjson restore_handles "$SELECTED_RESTORE_HANDLES" --argjson datafile_sets "$keys_json" \
    --argjson preparation "$preparation_json" --argjson storage "$storage_json" \
    '{schema_version:"1.0",collector:{name:"oracle.recovery.evidence",version:"1"},status:"passed",collected_at:$collected_at,target:{database_unique_name:$database,oracle_home:$oracle_home,owner:$owner,oracle_sid:$sid},backup:({root:$backup_root,storage:$storage,checksum_manifest:{path:$checksum_path,sha256:$checksum_sha},files:$files,oracle_home_archive:$archive,rman_backup_set_keys:$keys,selected_recovery_set:{observed_at:$observed_at,oldest_datafile_backup_completed_at:$completed_at,age_seconds_at_collection:$age_seconds,restore_piece_handles:$restore_handles,datafile_backup_sets:$datafile_sets},coverage:{datafiles_backed:$datafiles_backed,base_datafiles:$base_datafiles,datafiles_current:$datafiles_current,controlfile_records:$controlfile_records,spfile_records:$spfile_records,outside_root_pieces:0,unavailable_pieces:0}} + (if $preparation == null then {} else {preparation:$preparation} end)),source_snapshot:{path:$snapshot_path,sha256:$snapshot_sha},verification:{checksum_log:{path:$checksum_log,sha256:$checksum_log_sha},oracle_home_archive_log:{path:$archive_log,sha256:$archive_log_sha},rman_syntax:{log:{path:$rman_syntax_log,sha256:$rman_syntax_log_sha},exit_code:{path:$rman_syntax_rc_path,sha256:$rman_syntax_rc_sha,value:$rman_syntax_rc}},rman_log:{path:$rman_log,sha256:$rman_log_sha,exit_code:{path:$rman_rc_path,sha256:$rman_rc_sha,value:$rman_rc}}}}' >"$tmp"
  canonical=$(jq -cS . "$tmp")
  record_sha=$(opu_hash_string "$canonical")
  jq --arg record_sha "$record_sha" '. + {record_sha256:$record_sha}' "$tmp" >"$OUT"
  rm -f "$tmp"
  cat "$OUT"
}

main() {
  parse "$@"
  trap cleanup_runtime_command EXIT
  resolve_target
  mkdir -p "$(dirname "$OUT")"
  EVIDENCE_DIR="${OUT%.json}.d"
  [ ! -e "$EVIDENCE_DIR" ] || die "recovery evidence directory already exists: $EVIDENCE_DIR"
  mkdir "$EVIDENCE_DIR"
  validate_checksum_manifest
  validate_rman_sets
  emit_record
}

main "$@"
