#!/usr/bin/env bash
# Read-only evidence: never repairs privileges, extracts or executes a member.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin
ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/python.sh"
opu_python "$ROOT/lib/opu/extjob_provenance.py" "$@"
