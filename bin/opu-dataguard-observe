#!/usr/bin/env bash
# Read-only Data Guard observation. Emits broker/member/lag evidence without
# mutating the estate. TEST_MODE loads a fixture JSON; live mode queries
# role-specific V$DATABASE, V$DATAGUARD_STATS and V$ARCHIVE_DEST_STATUS views.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/common.sh"
. "$ROOT/lib/opu/dataguard.sh"

TEST_MODE=${OPU_DATAGUARD_TEST_MODE:-0}
FIXTURE=${OPU_DATAGUARD_TEST_FIXTURE:-}
ORACLE_HOME=""; ORACLE_SID=""; OUT=""

usage() {
  printf '%s\n' 'Usage: opu-dataguard-observe --oracle-home PATH --oracle-sid SID [--output ABSOLUTE_JSON]'
}

die() { opu_error "$*"; exit 65; }

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --oracle-home) ORACLE_HOME=${2:-}; shift 2 ;;
      --oracle-sid) ORACLE_SID=${2:-}; shift 2 ;;
      --output) OUT=${2:-}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  done
  opu_validate_identifier "$ORACLE_SID" oracle-sid || exit $?
  opu_validate_absolute_path "$ORACLE_HOME" oracle-home || exit $?
  opu_dataguard_validate_output "$OUT" || exit $?
  command -v jq >/dev/null || die 'jq is required'
}

emit_from_fixture() {
  [ -n "$FIXTURE" ] && [ -f "$FIXTURE" ] && [ ! -L "$FIXTURE" ] || die 'OPU_DATAGUARD_TEST_FIXTURE must be a regular file in TEST_MODE'
  jq -e --arg home "$ORACLE_HOME" --arg sid "$ORACLE_SID" '
    .schema_version == "1.0" and .collector.name == "oracle.dataguard.observe" and
    .target.oracle_home == $home and .target.oracle_sid == $sid
  ' "$FIXTURE" >/dev/null || die 'Data Guard fixture does not bind the requested home/SID'
  opu_dataguard_verify_document "$FIXTURE" || exit $?
  opu_dataguard_publish "$FIXTURE" "$OUT"
}

sqlplus_q() {
  local sql=$1 output
  [ -x "$ORACLE_HOME/bin/sqlplus" ] || die 'SQL*Plus is missing from the requested Oracle home'
  export ORACLE_HOME ORACLE_SID
  # WHENEVER catches SQL/OS failures; the tagged parser also rejects SP2 errors
  # and other diagnostics that SQL*Plus can print while returning exit zero.
  if ! output=$("$ORACLE_HOME/bin/sqlplus" -S -L "/ as sysdba" <<EOF
whenever oserror exit failure rollback
whenever sqlerror exit failure rollback
set heading off feedback off pagesize 0 linesize 2000 trimspool on verify off echo off
$sql
exit success
EOF
  ); then
    opu_error 'Data Guard SQL collection failed'
    printf '%s\n' "$output" >&2
    return 65
  fi
  printf '%s\n' "$output"
}

emit_live() {
  local identity rows samples role broker_status collected canonical hash tmp
  local dgmgrl_bin broker_output
  collected=$(opu_now_utc)
  rows=$(sqlplus_q "select 'DG_DATABASE|'||database_role||'|'||open_mode||'|'||protection_mode||'|'||
    db_unique_name||'|'||nvl(primary_db_unique_name,'~')||'|'||to_char(sysdate,'YYYY-MM-DD HH24:MI:SS')||'|'||
    dataguard_broker from v\$database;") || die 'could not collect database identity'
  identity=$(printf '%s\n' "$rows" | jq -eRsc --arg mode identity --argjson identity '{}' -f "$ROOT/lib/opu/dataguard_parse.jq") \
    || die 'invalid database identity output'
  role=$(jq -r '.database_role' <<<"$identity")
  case "$role" in
    PRIMARY)
      # This view reports destination health, not elapsed transport/apply lag.
      # Keep unavailable lag explicit; a primary-only scan cannot pass lag policy.
      rows=$(sqlplus_q "select 'DG_DEST|'||nvl(db_unique_name,'~')||'|'||status||'|'||
        nvl(recovery_mode,'~')||'|'||type||'|'||nvl(error,'~') from v\$archive_dest_status
        where type in ('PHYSICAL','LOGICAL','SNAPSHOT','FAR SYNC') order by dest_id;") \
        || die 'could not collect primary standby destinations'
      samples=$(printf '%s\n' "$rows" | jq -eRsc --arg mode primary --argjson identity "$identity" -f "$ROOT/lib/opu/dataguard_parse.jq") \
        || die 'invalid primary destination output'
      ;;
    *STANDBY*)
      rows=$(sqlplus_q "select 'DG_CLOCK|'||to_char(sysdate,'YYYY-MM-DD HH24:MI:SS') from dual;
        select 'DG_APPLY|'||name||'|'||action from v\$dataguard_process where name='MRP0';
        select 'DG_METRIC|'||name||'|'||nvl(value,'~')||'|'||nvl(unit,'~')||'|'||
          nvl(time_computed,'~')||'|'||nvl(datum_time,'~')||'|'||nvl(source_db_unique_name,'~')
          from v\$dataguard_stats where name in ('transport lag','apply lag') order by name;") \
        || die 'could not collect standby lag metrics'
      samples=$(printf '%s\n' "$rows" | jq -eRsc --arg mode standby --argjson identity "$identity" -f "$ROOT/lib/opu/dataguard_parse.jq") \
        || die 'invalid standby metric output'
      ;;
    *) die "unsupported Data Guard observation role: $role" ;;
  esac

  broker_status=unavailable
  dgmgrl_bin=$ORACLE_HOME/bin/dgmgrl
  if [ -x "$dgmgrl_bin" ]; then
    # Single-command mode returns the command's status. Binary existence or an
    # error containing "Configuration Status" cannot establish healthy broker.
    if broker_output=$("$dgmgrl_bin" -silent / 'SHOW CONFIGURATION;' 2>&1) &&
       ! grep -qE 'ORA-[0-9]+|DGM-[0-9]+' <<<"$broker_output" &&
       grep -qE '^Configuration[[:space:]]+-' <<<"$broker_output" &&
       grep -qE '^[[:space:]]*SUCCESS([[:space:]]|$)' <<<"$broker_output"; then
      broker_status=configured
    else
      broker_status=unverified
    fi
  fi

  tmp=$(mktemp "${TMPDIR:-/tmp}/opu-dg.XXXXXX")
  trap 'rm -f "${tmp:-}"' EXIT
  jq -cn --arg collected "$collected" --arg home "$ORACLE_HOME" --arg sid "$ORACLE_SID" \
    --argjson identity "$identity" --argjson samples "$samples" --arg broker "$broker_status" '
    {schema_version:"1.0",collector:{name:"oracle.dataguard.observe",version:"2"},collected_at:$collected,
     target:{oracle_home:$home,oracle_sid:$sid,db_unique_name:$identity.db_unique_name},
     primary:($identity | del(.sampled_at_local)),broker:{status:$broker},members:$samples.members,
     sampling:{source:"live_sql",clock:"database_local",sampled_at_local:$samples.sampled_at_local}}' >"$tmp"
  canonical=$(jq -cS . "$tmp"); hash=$(opu_hash_string "$canonical")
  jq --arg hash "$hash" '.record_sha256=$hash' "$tmp" >"$tmp.hashed"
  opu_dataguard_publish "$tmp.hashed" "$OUT"
  rm -f "$tmp.hashed"
  rm -f "$tmp"
  trap - EXIT
}

main() {
  parse "$@"
  if [ "$TEST_MODE" = 1 ]; then
    emit_from_fixture
  else
    emit_live
  fi
}

main "$@"
