#!/usr/bin/env bash
# Emits a standby-first patching order from sealed Data Guard observe evidence.
# Primary is always last. Does not authorize mutation.
set -euo pipefail
umask 077
export LC_ALL=C LANG=C PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
. "$ROOT/lib/opu/common.sh"
. "$ROOT/lib/opu/dataguard.sh"

OBSERVE=""; EVAL=""; OUT=""

usage() {
  printf '%s\n' 'Usage: opu-dataguard-plan-order --observe ABSOLUTE_JSON --evaluation ABSOLUTE_JSON [--output ABSOLUTE_JSON]'
}

die() { opu_error "$*"; exit 65; }

parse() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --observe) OBSERVE=${2:-}; shift 2 ;;
      --evaluation) EVAL=${2:-}; shift 2 ;;
      --output) OUT=${2:-}; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; exit 64 ;;
    esac
  done
  for pair in "$OBSERVE|observe" "$EVAL|evaluation"; do
    opu_validate_absolute_path "${pair%%|*}" "${pair#*|}" || exit $?
    [ -f "${pair%%|*}" ] && [ ! -L "${pair%%|*}" ] || { opu_error "${pair#*|} missing"; exit 66; }
  done
  opu_dataguard_validate_output "$OUT" || exit $?
  command -v jq >/dev/null || die 'jq is required'
}

main() {
  local order tmp canonical hash
  parse "$@"
  opu_dataguard_verify_document "$OBSERVE" || exit $?
  opu_dataguard_verify_document "$EVAL" || exit $?
  jq -e '.status == "ready_for_standby_first"' "$EVAL" >/dev/null || die 'Data Guard evaluation is not ready_for_standby_first'
  jq -e --arg sha "$(opu_hash_file "$OBSERVE")" '.evidence.observe_sha256 == $sha' "$EVAL" >/dev/null \
    || die 'evaluation does not bind the supplied observe evidence'

  # Live observations seal DB_UNIQUE_NAME from V$DATABASE; SID is an instance
  # name and is not an acceptable database identity for new live collections.
  jq -e 'if .collector.version == "2" or .sampling.source == "live_sql" then
    (.target.db_unique_name | type == "string" and length > 0) and
    .target.db_unique_name == .primary.db_unique_name else true end' "$OBSERVE" >/dev/null \
    || die 'live Data Guard observation lacks a consistent native database identity'
  order=$(jq -c '
    (.target.db_unique_name // .primary.db_unique_name // .target.oracle_sid) as $local_name |
    if ($local_name | type != "string" or length == 0) then error("database identity is missing") else . end |
    (.primary.database_role) as $role |
    if $role == "PRIMARY" then
      ((.members // []) | map(select(.db_unique_name != null)) | sort_by(.apply_lag_seconds // 0)) as $standbys |
      {
        schema_version:"1.0",
        strategy:"standby_first",
        order: (
          ($standbys | map({db_unique_name,role:"STANDBY",apply_lag_seconds:(.apply_lag_seconds // 0)}))
          + [{db_unique_name:$local_name,role:"PRIMARY",apply_lag_seconds:0}]
        )
      }
    elif ($role | test("STANDBY$")) then
      {
        schema_version:"1.0",
        strategy:"standby_first",
        order: [{db_unique_name:$local_name,role:"STANDBY",observed_role:$role,apply_lag_seconds:0}]
      }
    else
      error("unsupported role for plan order")
    end
  ' "$OBSERVE") || die 'could not derive standby-first order'

  tmp=$(mktemp "${TMPDIR:-/tmp}/opu-dg-order.XXXXXX")
  jq -cn --argjson order "$order" --arg eval_sha "$(opu_hash_file "$EVAL")" --arg observe_sha "$(opu_hash_file "$OBSERVE")" \
    '$order + {evidence:{evaluation_sha256:$eval_sha,observe_sha256:$observe_sha}}' >"$tmp"
  canonical=$(jq -cS . "$tmp"); hash=$(opu_hash_string "$canonical")
  jq --arg hash "$hash" '.record_sha256=$hash' "$tmp" >"$tmp.hashed"
  opu_dataguard_publish "$tmp.hashed" "$OUT"
  rm -f "$tmp.hashed"
  rm -f "$tmp"
}

main "$@"
