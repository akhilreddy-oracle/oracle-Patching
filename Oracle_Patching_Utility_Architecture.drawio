        <mxCell id="p3-artifact" value="&lt;b&gt;3. Validate Artifact&lt;/b&gt;&lt;br&gt;digest • metadata • platform • safe staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2E74B5;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="620" y="120" width="240" height="85" as="geometry"/></mxCell>
