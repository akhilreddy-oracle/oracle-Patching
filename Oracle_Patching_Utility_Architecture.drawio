  <diagram id="delivery-waves" name="4. Delivery Waves and Gates">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0w"/>
        <mxCell id="1w" parent="0w"/>
        <mxCell id="p4-title" value="Contract-First Parallel Delivery — 114 Independently Testable Work Packages" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#203748;" vertex="1" parent="1w"><mxGeometry x="250" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="p4-start" value="&lt;b&gt;START HERE&lt;/b&gt;&lt;br&gt;CON-01 Canonical identities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#22643A;fontColor=#22643A;fontStyle=1;fontSize=15;" vertex="1" parent="1w"><mxGeometry x="40" y="100" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w0" value="&lt;b&gt;Wave 0 — Freeze System Language&lt;/b&gt;&lt;br&gt;IDs • schemas • errors • task/result/event contracts • compatibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2E74B5;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="340" y="100" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w1" value="&lt;b&gt;Wave 1 — Parallel Foundations&lt;/b&gt;&lt;br&gt;agent transport • inventory persistence • artifact store • security/audit • workflow kernel • CI/lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2E74B5;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="700" y="100" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w2" value="&lt;b&gt;Wave 2 — Trustworthy Inventory&lt;/b&gt;&lt;br&gt;standalone discovery • identity reconciliation • conflicts • history • accuracy metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2E74B5;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="1140" y="100" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w3" value="&lt;b&gt;Wave 3 — Readiness Product&lt;/b&gt;&lt;br&gt;patch metadata • compliance • policy • approvals • locks • read-only prechecks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="1140" y="300" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w4" value="&lt;b&gt;Wave 4 — Fault-Injected Simulator&lt;/b&gt;&lt;br&gt;duplicate • restart • expiry • storage failure • approval drift • recovery ordering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="700" y="300" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w5" value="&lt;b&gt;Wave 5 — Standalone Oracle Lab&lt;/b&gt;&lt;br&gt;RU execution • interruption matrix • rollback/recovery drills • disabled-by-default production gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="260" y="300" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w6" value="&lt;b&gt;Wave 6 — Productize and Pilot&lt;/b&gt;&lt;br&gt;UI • integrations • on-prem/air-gapped packaging • recovery drill • non-production canary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#22643A;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="260" y="500" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-w7" value="&lt;b&gt;Wave 7 — Topology Expansion&lt;/b&gt;&lt;br&gt;OJVM • Data Guard • GI/RAC through separate adapters and release gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#22643A;fontColor=#203748;fontSize=13;" vertex="1" parent="1w"><mxGeometry x="700" y="500" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-gates" value="&lt;b&gt;QUALITY GATES&lt;/b&gt;&lt;br&gt;Q0 Contract → Q1 Read-only safety → Q2 Discovery accuracy → Q3 Degraded operation → Q4 Simulation → Q5 Standalone lab → Q6 Topology → Q7 Pilot/production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#2E74B5;fontColor=#1F4D78;fontStyle=1;fontSize=14;" vertex="1" parent="1w"><mxGeometry x="1140" y="480" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-lanes" value="&lt;b&gt;Parallel workstreams after contract freeze&lt;/b&gt;&lt;br&gt;Agent | Discovery | Inventory | Artifact/Compliance | Security | Workflow | Readiness | Execution | Experience | Quality/Platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#667085;fontColor=#203748;fontSize=14;" vertex="1" parent="1w"><mxGeometry x="260" y="700" width="1260" height="90" as="geometry"/></mxCell>
        <mxCell id="p4-rule" value="Production execution remains disabled until the relevant quality gate is signed off with retained evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F2;strokeColor=#9B1C1C;fontColor=#9B1C1C;fontStyle=1;fontSize=14;" vertex="1" parent="1w"><mxGeometry x="480" y="840" width="820" height="55" as="geometry"/></mxCell>
        <mxCell id="p4-e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;" edge="1" parent="1w" source="p4-start" target="p4-w0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E74B5;" edge="1" parent="1w" source="p4-w0" target="p4-w1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E74B5;" edge="1" parent="1w" source="p4-w1" target="p4-w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B5852B;" edge="1" parent="1w" source="p4-w2" target="p4-w3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B5852B;" edge="1" parent="1w" source="p4-w3" target="p4-w4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1w" source="p4-w4" target="p4-w5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;" edge="1" parent="1w" source="p4-w5" target="p4-w6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;" edge="1" parent="1w" source="p4-w6" target="p4-w7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
