        <mxCell id="p3-e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;fontColor=#22643A;" edge="1" parent="1p" source="p3-precheck" target="p3-approval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B5852B;" edge="1" parent="1p" source="p3-approval" target="p3-window"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;fontColor=#22643A;" edge="1" parent="1p" source="p3-window" target="p3-quiesce"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e8" value="no / expired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;fontColor=#9B1C1C;" edge="1" parent="1p" source="p3-window" target="p3-blocked"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1p" source="p3-quiesce" target="p3-apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1p" source="p3-apply" target="p3-binverify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1p" source="p3-binverify" target="p3-start"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1p" source="p3-start" target="p3-sql"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9B1C1C;" edge="1" parent="1p" source="p3-sql" target="p3-post"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#22643A;fontColor=#22643A;" edge="1" parent="1p" source="p3-post" target="p3-success"><mxGeometry relative="1" as="geometry"/></mxCell>
