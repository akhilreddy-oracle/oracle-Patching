        <mxCell id="p3-blocked" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;Publish reason-coded findings and evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F2;strokeColor=#9B1C1C;fontColor=#9B1C1C;fontStyle=1;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="930" y="280" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-approval" value="&lt;b&gt;4. Approval Gate&lt;/b&gt;&lt;br&gt;bind plan hash • targets • topology • artifacts • policy • window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1170" y="120" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="p3-window" value="Window and approvals valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontStyle=1;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1490" y="105" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="p3-quiesce" value="&lt;b&gt;5. Quiesce&lt;/b&gt;&lt;br&gt;drain traffic • stop only approved services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1460" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-apply" value="&lt;b&gt;6. Apply Binary Patch&lt;/b&gt;&lt;br&gt;typed adapter • durable local supervisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1170" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-binverify" value="&lt;b&gt;7. Verify Binary State&lt;/b&gt;&lt;br&gt;re-observe inventory and exact expected patch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="880" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-start" value="&lt;b&gt;8. Start Database&lt;/b&gt;&lt;br&gt;required mode • listeners • services • PDB states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="590" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-sql" value="&lt;b&gt;9. SQL Patch&lt;/b&gt;&lt;br&gt;approved datapatch profile • every required container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F8;strokeColor=#9B1C1C;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="300" y="310" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3-post" value="Postchecks pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontStyle=1;fontSize=14;" vertex="1" parent="1p"><mxGeometry x="50" y="295" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="p3-success" value="&lt;b&gt;SUCCEEDED&lt;/b&gt;&lt;br&gt;release traffic • update compliance • retain evidence and recovery point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF8F0;strokeColor=#22643A;fontColor=#22643A;fontStyle=1;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="40" y="500" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p3-reconcile" value="&lt;b&gt;Outcome Reconciliation&lt;/b&gt;&lt;br&gt;observe process, inventory, DB state, SQL registry, and logs&lt;br&gt;COMPLETE • NOT_STARTED • RUNNING • PARTIAL • INDETERMINATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF5;strokeColor=#2E74B5;fontColor=#203748;fontSize=14;" vertex="1" parent="1p"><mxGeometry x="540" y="500" width="520" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-recoverygate" value="Safe recovery path?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontStyle=1;fontSize=14;" vertex="1" parent="1p"><mxGeometry x="1140" y="500" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="p3-rollback" value="&lt;b&gt;Approved Recovery Plan&lt;/b&gt;&lt;br&gt;binary rollback / switchback / SQL recovery / RMAN / topology recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#B5852B;fontColor=#203748;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1430" y="490" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="p3-manual" value="&lt;b&gt;MANUAL INTERVENTION&lt;/b&gt;&lt;br&gt;preserve evidence • block retries • run approved DBA procedure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F2;strokeColor=#9B1C1C;fontColor=#9B1C1C;fontStyle=1;fontSize=13;" vertex="1" parent="1p"><mxGeometry x="1120" y="720" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-rule" value="&lt;b&gt;Execution invariant&lt;/b&gt;&lt;br&gt;Transport failure is not Oracle failure. Exit code zero is not sufficient. Every destructive phase advances only after an independently observed completion predicate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#2E74B5;fontColor=#1F4D78;fontStyle=1;fontSize=14;" vertex="1" parent="1p"><mxGeometry x="300" y="720" width="700" height="95" as="geometry"/></mxCell>
        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E74B5;" edge="1" parent="1p" source="p3-plan" target="p3-rediscover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E74B5;" edge="1" parent="1p" source="p3-rediscover" target="p3-artifact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E74B5;" edge="1" parent="1p" source="p3-artifact" target="p3-precheck"><mxGeometry relative="1" as="geometry"/></mxCell>
