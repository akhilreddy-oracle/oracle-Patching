{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oracle-patching/grid-recovery-evidence-v1.schema.json",
  "title": "Oracle Grid Infrastructure Recovery Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collector",
    "status",
    "collected_at",
    "target",
    "source_snapshot",
    "source_bundle",
    "backup",
    "verification",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "oracle.grid.recovery.evidence"},
        "version": {"const": "1"}
      }
    },
    "status": {"const": "passed"},
    "collected_at": {"type": "string", "format": "date-time"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_home", "owner", "nodes", "central_inventory", "oraInst_loc"],
      "properties": {
        "grid_home": {"type": "string", "pattern": "^/"},
        "owner": {"type": "string", "minLength": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
        },
        "central_inventory": {"type": "string", "pattern": "^/"},
        "oraInst_loc": {"type": "string", "pattern": "^/"}
      }
    },
    "source_snapshot": {"$ref": "#/$defs/path_digest"},
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_manifest",
        "grid_home_archive",
        "central_inventory_archive",
        "oraInst_loc",
        "ocr_backup",
        "olr_backups"
      ],
      "properties": {
        "checksum_manifest": {"$ref": "#/$defs/path_digest"},
        "grid_home_archive": {"$ref": "#/$defs/path_digest"},
        "central_inventory_archive": {"$ref": "#/$defs/path_digest"},
        "oraInst_loc": {"$ref": "#/$defs/path_digest"},
        "ocr_backup": {"$ref": "#/$defs/path_digest"},
        "olr_backups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node_path_digest"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checksum_log",
        "grid_home_archive_log",
        "central_inventory_archive_log",
        "ocr_backup_log",
        "olr_backup_logs",
        "crs_health_log",
        "active_version_log",
        "ocrcheck_log",
        "voting_disks_log"
      ],
      "properties": {
        "checksum_log": {"$ref": "#/$defs/path_digest"},
        "grid_home_archive_log": {"$ref": "#/$defs/path_digest"},
        "central_inventory_archive_log": {"$ref": "#/$defs/path_digest"},
        "ocr_backup_log": {"$ref": "#/$defs/path_digest"},
        "olr_backup_logs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node_path_digest"}
        },
        "crs_health_log": {"$ref": "#/$defs/path_digest"},
        "active_version_log": {"$ref": "#/$defs/path_digest"},
        "ocrcheck_log": {"$ref": "#/$defs/path_digest"},
        "voting_disks_log": {"$ref": "#/$defs/path_digest"}
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "node_path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "path", "sha256"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
