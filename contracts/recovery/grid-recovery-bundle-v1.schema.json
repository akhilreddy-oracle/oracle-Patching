{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oracle-patching/grid-recovery-bundle-v1.schema.json",
  "title": "Oracle Grid Infrastructure Recovery Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collector", "status", "target", "backup", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "oracle.grid.recovery.bundle"},
        "version": {"const": "1"}
      }
    },
    "status": {"const": "prepared"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_home", "owner", "central_inventory", "oraInst_loc"],
      "properties": {
        "grid_home": {"type": "string", "pattern": "^/"},
        "owner": {"type": "string", "minLength": 1},
        "central_inventory": {"type": "string", "pattern": "^/"},
        "oraInst_loc": {"type": "string", "pattern": "^/"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "checksum_manifest",
        "grid_home_archive",
        "central_inventory_archive",
        "oraInst_loc",
        "ocr_backup",
        "olr_backups"
      ],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "checksum_manifest": {"$ref": "#/$defs/path_digest"},
        "grid_home_archive": {"$ref": "#/$defs/source_path_digest"},
        "central_inventory_archive": {"$ref": "#/$defs/source_path_digest"},
        "oraInst_loc": {"$ref": "#/$defs/source_path_digest"},
        "ocr_backup": {"$ref": "#/$defs/path_digest"},
        "olr_backups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node_source_path_digest"}
        }
      }
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source_path"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_path": {"type": "string", "pattern": "^/"}
      }
    },
    "node_source_path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "path", "sha256", "source_path"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_path": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
