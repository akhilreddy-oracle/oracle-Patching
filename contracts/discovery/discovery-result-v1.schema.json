{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle-patching-utility.invalid/contracts/discovery-result-v1.schema.json",
  "title": "Oracle Patching Utility Discovery Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collector",
    "status",
    "coverage",
    "errors",
    "observations",
    "resources",
    "conflicts",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "status": {
      "enum": ["complete", "partial", "failed", "unsupported"]
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/error"}
    },
    "observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/typedRecord"}
    },
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/typedRecord"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_sources", "errors", "observations", "resources", "conflicts"],
      "properties": {
        "coverage_sources": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "observations": {"type": "integer", "minimum": 0},
        "resources": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "reason_code", "evidence_path", "evidence_sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["complete", "partial", "unavailable", "failed", "unsupported", "not_applicable"]
        },
        "reason_code": {"type": ["string", "null"]},
        "evidence_path": {"type": ["string", "null"]},
        "evidence_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "phase", "code", "severity", "message", "retryable"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "phase": {"enum": ["detect", "collect", "validate", "reconcile"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "severity": {"enum": ["warning", "blocker"]},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "typedRecord": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource_kind", "natural_key", "reason_codes", "sources"],
      "properties": {
        "kind": {"enum": ["identity_conflict", "discovery_conflict"]},
        "resource_kind": {"type": "string", "minLength": 1},
        "natural_key": {"type": "string", "minLength": 1},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
