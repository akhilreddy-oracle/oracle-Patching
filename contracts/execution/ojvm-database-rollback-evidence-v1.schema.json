{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oracle-patching/contracts/execution/ojvm-database-rollback-evidence-v1.schema.json",
  "title": "OJVM Database Rollback Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collector", "intent", "plan_id", "task_id", "plan_sha256",
    "status", "postcondition", "outcome_class", "started_at", "finished_at",
    "exit_code", "actor", "stage", "target", "patch", "recovery",
    "source_apply", "logs", "record_sha256"
  ],
  "properties": {
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 0 },
    "schema_version": { "const": "1.0" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "oracle.database.ojvm.rollback.executor" },
        "version": { "const": "1" }
      }
    },
    "intent": { "const": "patch_rollback" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "task_id": { "$ref": "#/$defs/identifier" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["succeeded", "failed"] },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "unknown"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "outcome_class": {
      "enum": ["no_mutation", "binary_state_known", "binary_state_unknown", "database_down", "recovery_required"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "actor": { "$ref": "#/$defs/identifier" },
    "stage": {
      "enum": [
        "ojvm_rollback_precheck", "ojvm_rollback_stop_all", "ojvm_rollback_binary",
        "ojvm_rollback_start_upgrade", "ojvm_rollback_datapatch",
        "ojvm_rollback_restart_normal", "ojvm_rollback_final_validate"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_unique_name", "oracle_home", "owner", "oracle_sid"],
      "properties": {
        "database_unique_name": { "$ref": "#/$defs/identifier" },
        "oracle_home": { "$ref": "#/$defs/absolutePath" },
        "owner": { "$ref": "#/$defs/identifier" },
        "oracle_sid": { "anyOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_id", "artifact_sha256"],
      "properties": {
        "patch_id": { "type": "string", "pattern": "^[0-9]{1,20}$" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "record_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_apply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "final_evidence_sha256", "final_evidence_record_sha256"],
      "properties": {
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "final_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "final_evidence_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "$ref": "#/$defs/log" },
        "stderr": { "$ref": "#/$defs/log" }
      }
    },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/[^\\r\\n\\t]*$" },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
