{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oracle-patching/contracts/execution/controller-evidence-custody-v1.schema.json",
  "title": "Controller-custodied execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collector", "plan_id", "task_id", "collected_at",
    "evidence", "files", "record_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "oracle.patch.controller.evidence_custody" },
        "version": { "const": "1" }
      }
    },
    "plan_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "collected_at": { "$ref": "#/$defs/timestamp" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "custody_path", "sha256", "record_sha256"],
      "properties": {
        "source_path": { "$ref": "#/$defs/absolute_path" },
        "custody_path": { "$ref": "#/$defs/absolute_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_path", "custody_path", "sha256"],
        "properties": {
          "role": { "enum": ["stdout", "stderr", "artifact"] },
          "source_path": { "$ref": "#/$defs/absolute_path" },
          "custody_path": { "$ref": "#/$defs/absolute_path" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "absolute_path": { "type": "string", "pattern": "^/" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
