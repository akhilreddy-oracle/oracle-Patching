{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oracle-patching/contracts/execution/grid-opatchauto-execution-evidence-v1.schema.json",
  "title": "Grid Infrastructure OPatchAuto rolling patch execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collector", "intent", "plan_id", "task_id", "plan_sha256",
    "status", "postcondition", "outcome_class", "started_at", "finished_at", "exit_code",
    "actor", "stage", "target", "patch", "source_documents", "recovery", "cluster", "artifacts",
    "logs", "record_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "oracle.grid.opatchauto.executor" },
        "version": { "const": "1" }
      }
    },
    "intent": { "const": "patch_apply" },
    "plan_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["succeeded", "failed"] },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "unknown"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "outcome_class": {
      "enum": [
        "no_mutation", "binary_state_known", "binary_state_unknown",
        "grid_state_unknown", "recovery_required"
      ]
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "actor": { "$ref": "#/$defs/id" },
    "stage": {
      "enum": [
        "opatchauto_precheck", "opatchauto_apply", "opatchauto_resume_check",
        "opatchauto_node_validate", "opatchauto_cluster_final_validate"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_home", "owner", "coordinator_node", "node"],
      "properties": {
        "grid_home": { "$ref": "#/$defs/absolute_path" },
        "owner": { "$ref": "#/$defs/id" },
        "coordinator_node": { "$ref": "#/$defs/id" },
        "node": { "$ref": "#/$defs/id" }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_id", "artifact_sha256"],
      "properties": {
        "patch_id": { "type": "string", "pattern": "^[0-9]{1,20}$" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "reconciliation", "artifact_manifest", "procedure_validation", "compatibility", "policy"],
      "properties": {
        "readiness": { "$ref": "#/$defs/sha256" },
        "reconciliation": { "$ref": "#/$defs/sha256" },
        "artifact_manifest": { "$ref": "#/$defs/sha256" },
        "procedure_validation": { "$ref": "#/$defs/sha256" },
        "compatibility": { "$ref": "#/$defs/sha256" },
        "policy": { "$ref": "#/$defs/sha256" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "record_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_version", "upgrade_state", "active_patch_level", "release_patch_level"],
      "properties": {
        "active_version": { "type": "string", "minLength": 1 },
        "upgrade_state": { "type": "string", "minLength": 1 },
        "active_patch_level": { "type": "string", "minLength": 1 },
        "release_patch_level": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/log" }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "$ref": "#/$defs/log" },
        "stderr": { "$ref": "#/$defs/log" }
      }
    },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "absolute_path": { "type": "string", "pattern": "^/" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
